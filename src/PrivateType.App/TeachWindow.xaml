<Window x:Class="PrivateType.App.TeachWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PrivateType teach vocabulary" Icon="/PrivateType;component/Assets/PrivateType.ready.ico" Width="640" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" ShowInTaskbar="True"
        Background="Transparent" Foreground="{DynamicResource ColorText}" FontFamily="{DynamicResource AppFont}" PreviewKeyDown="HandleKeys">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="FormStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <!-- Each word is a key. A picked word is pressed: flat, lowered, with an accent edge. -->
      <Style x:Key="WordChip" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource ColorText}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Margin" Value="0,0,6,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ToggleButton">
              <Grid>
                <Border x:Name="Chip" MinWidth="30" Padding="10,5,10,4" CornerRadius="5"
                        Background="{DynamicResource ColorKeycap}" BorderBrush="{DynamicResource ColorKeycapEdge}" BorderThickness="0,0,0,3">
                  <TextBlock x:Name="Label" HorizontalAlignment="Center" Text="{TemplateBinding Content}" />
                </Border>
                <Border x:Name="FocusRing" Margin="-3" BorderBrush="{DynamicResource ColorAccent}" BorderThickness="2" CornerRadius="8" Visibility="Collapsed" IsHitTestVisible="False" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Chip" Property="Background" Value="{DynamicResource ColorNeutral800}" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="Chip" Property="Background" Value="{DynamicResource ColorAccent900}" />
                  <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource ColorAccent}" />
                  <!-- An outline instead of the raised edge: the padding takes up the difference so the word stays on the line. -->
                  <Setter TargetName="Chip" Property="BorderThickness" Value="1.5" />
                  <Setter TargetName="Chip" Property="Padding" Value="8.5,3.5,8.5,5.5" />
                  <Setter Property="Foreground" Value="{DynamicResource ColorAccent300}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                </Trigger>
                <!-- Words already covered by a fix are struck through and cannot be picked again. -->
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Chip" Property="Background" Value="Transparent" />
                  <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource ColorNeutral800}" />
                  <Setter TargetName="Chip" Property="BorderThickness" Value="1" />
                  <Setter TargetName="Chip" Property="Padding" Value="9,4,9,6" />
                  <Setter TargetName="Label" Property="TextDecorations" Value="Strikethrough" />
                  <Setter Property="Foreground" Value="{DynamicResource ColorNeutral400}" />
                  <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </Window.Resources>
  <Border Margin="8" Background="{DynamicResource ColorSurface}" BorderBrush="{DynamicResource ColorDivider}" BorderThickness="1" CornerRadius="12">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="40" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <!-- Title bar: the same keycap mark and name as Settings. -->
      <Border Background="{DynamicResource ColorSurface}" BorderBrush="{DynamicResource ColorHairline}" BorderThickness="0,0,0,1" CornerRadius="11,11,0,0" MouseLeftButtonDown="DragWindow">
        <Grid Margin="16,0,8,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="18" Height="18" CornerRadius="4" Background="{DynamicResource ColorKeycap}" BorderBrush="{DynamicResource ColorKeycapEdge}" BorderThickness="0,0,0,2">
              <Ellipse Width="6" Height="6" Fill="{DynamicResource ColorAccent400}" />
            </Border>
            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Text="Teach from last dictation" />
          </StackPanel>
          <Button Width="28" Height="28" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Center" Content="×" FontSize="18" Style="{StaticResource GhostButton}"
                  Click="CloseWindow" AutomationProperties.Name="Close" />
        </Grid>
      </Border>
      <Grid x:Name="EditPanel" Grid.Row="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="24,16,24,18">
          <TextBlock FontSize="13" TextWrapping="Wrap" Text="Click the words it got wrong, then type the correction." />
          <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource ColorNeutral400}" TextWrapping="Wrap" Text="For a long phrase, click its first and last word." />
          <!-- The sentence as a row of word keys; it grows with the sentence and scrolls only when long. -->
          <ScrollViewer Margin="0,14,0,0" MaxHeight="200" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <ItemsControl x:Name="WordList" AutomationProperties.Name="Words from the last dictation" KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Cycle">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <ToggleButton Style="{StaticResource WordChip}" Content="{Binding Text}" IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding IsAvailable}" Tag="{Binding}"
                                Click="ActivateWord" PreviewKeyDown="WordKeyDown" AutomationProperties.Name="{Binding Text}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <!-- Holds no line while there is nothing to say, so the form sits one group gap below the words. -->
          <TextBlock x:Name="SelectionHint" Margin="0,8,0,0" Foreground="{DynamicResource ColorAccent300}" FontSize="12" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Style.Triggers>
                  <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="180" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock FontSize="12" Foreground="{DynamicResource ColorNeutral400}" Text="Write it as" />
              <TextBox x:Name="DesiredBox" Margin="0,6,0,0" Height="34" Padding="8,0" MaxLength="120" FontSize="13"
                       TextChanged="DesiredChanged" PreviewKeyDown="DesiredKeyDown" AutomationProperties.Name="Write it as" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock FontSize="12" Foreground="{DynamicResource ColorNeutral400}" Text="Save for" />
              <ComboBox x:Name="ScopeBox" Margin="0,6,0,0" Height="34" Style="{StaticResource FieldComboBox}" SelectedValuePath="Code" IsTextSearchEnabled="True" TextSearch.TextPath="DisplayName"
                        MaxDropDownHeight="300" AutomationProperties.Name="Save for language" SelectionChanged="ScopeChanged">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Foreground="{DynamicResource ColorText}" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
            <!-- Save fix (filled, in the footer) saves what is typed here; this dashed key only sets it aside to fix more words first,
                 the same "+ Add" key as Settings uses for another shortcut or phrase. -->
            <Button x:Name="AddFixButton" Grid.Column="4" Style="{StaticResource GhostKeyButton}" VerticalAlignment="Bottom" Height="34" Content="+ Another fix" Click="AddFix" />
          </Grid>
          <StackPanel x:Name="FixesPanel" Margin="0,8,0,0" Visibility="Collapsed">
            <TextBlock Style="{StaticResource GroupLabel}" Margin="0,14,0,4" Text="FIXES TO SAVE" />
            <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
              <ItemsControl x:Name="FixList" AutomationProperties.Name="Fixes to save">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource TableRow}" MinHeight="36" Padding="0,3" Background="Transparent">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" FontSize="13" Text="{Binding Phrase}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource PageNote}" TextWrapping="NoWrap" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                        <Button x:Name="RemoveFixButton" Grid.Column="2" Style="{StaticResource RowRemoveButton}" VerticalAlignment="Center" Tag="{Binding}" Click="RemoveFix"
                                ToolTip="{Binding RemoveName}" AutomationProperties.Name="{Binding RemoveName}" />
                        <!-- The fix being written has no remove key: it says whether Save includes it. -->
                        <Border x:Name="DraftChip" Grid.Column="2" Margin="12,0,0,0" Style="{StaticResource StatusChip}" Visibility="Collapsed">
                          <TextBlock Text="{Binding DraftState}" />
                        </Border>
                      </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding IsDraft}" Value="True">
                        <Setter TargetName="RemoveFixButton" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="DraftChip" Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>
          <TextBlock Margin="0,16,0,0" Style="{StaticResource PageNote}" Text="Fixes apply to future dictations; text already typed stays as it is." />
        </StackPanel>
        <!-- Slim footer: the result on the left, Cancel as text and the filled Save on the right. -->
        <Border Grid.Row="1" Padding="24,10,16,12" BorderBrush="{DynamicResource ColorHairline}" BorderThickness="0,1,0,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ErrorText" Margin="0,0,16,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource ColorWarning}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Style="{StaticResource GhostButton}" Margin="0,0,8,0" Height="32" Padding="12,0" Content="Cancel" Click="CloseWindow" />
              <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Height="32" Padding="16,0" Content="Save fix" IsDefault="True" Click="Save" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
      <Grid x:Name="SavedPanel" Grid.Row="1" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="24,18,24,24">
          <TextBlock FontSize="15" FontWeight="SemiBold" Text="Saved to your vocabulary" />
          <TextBlock x:Name="SavedText" Margin="0,8,0,0" FontSize="13" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
          <TextBlock x:Name="SavedNoteText" Margin="0,8,0,0" Style="{StaticResource PageNote}" />
        </StackPanel>
        <Border Grid.Row="1" Padding="24,10,16,12" BorderBrush="{DynamicResource ColorHairline}" BorderThickness="0,1,0,0">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="OpenVocabularyButton" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Height="32" Padding="12,0" Content="Open vocabulary" Click="OpenVocabulary" />
            <Button x:Name="DoneButton" Style="{StaticResource PrimaryButton}" Height="32" Padding="16,0" Content="Done" Click="Done" />
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
