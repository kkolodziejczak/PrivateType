<Window x:Class="PrivateType.App.TeachWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PrivateType teach vocabulary" Icon="/PrivateType;component/Assets/PrivateType.ready.ico" Width="640" Height="660"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" ShowInTaskbar="True"
        Background="Transparent" Foreground="{DynamicResource ColorText}" FontFamily="{DynamicResource AppFont}" PreviewKeyDown="HandleKeys">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="FormStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="WordChip" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource ColorText}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ToggleButton">
              <Border x:Name="Chip" Padding="9,5" CornerRadius="7" Background="{DynamicResource ColorBg}" BorderBrush="{DynamicResource ColorDivider}" BorderThickness="1">
                <TextBlock x:Name="Label" Text="{TemplateBinding Content}" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource ColorAccent}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource ColorAccent400}" />
                  <Setter TargetName="Chip" Property="BorderThickness" Value="2" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="Chip" Property="Background" Value="{DynamicResource ColorAccent800}" />
                  <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource ColorAccent}" />
                  <Setter Property="Foreground" Value="{DynamicResource ColorAccent100}" />
                </Trigger>
                <!-- Words already covered by a fix are struck through and cannot be picked again. -->
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource ColorAccent400}" />
                  <Setter TargetName="Chip" Property="Opacity" Value="0.6" />
                  <Setter TargetName="Label" Property="TextDecorations" Value="Strikethrough" />
                  <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </Window.Resources>
  <Border Margin="8" Background="{DynamicResource ColorSurface}" BorderBrush="{DynamicResource ColorDivider}" BorderThickness="1" CornerRadius="16">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="42" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Border Background="{DynamicResource ColorNeutral900}" CornerRadius="15,15,0,0" MouseLeftButtonDown="DragWindow">
        <Grid Margin="16,0,8,0">
          <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource ColorText}" Opacity="0.8" FontSize="13" Text="PrivateType — teach vocabulary" />
          <Button Width="28" Height="28" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Center" Content="×" FontSize="18"
                  Background="Transparent" BorderBrush="Transparent" Foreground="{DynamicResource ColorNeutral400}" Click="CloseWindow" AutomationProperties.Name="Close" />
        </Grid>
      </Border>
      <Grid x:Name="EditPanel" Grid.Row="1" Margin="22">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
          <TextBlock FontSize="20" FontWeight="SemiBold" Text="Teach from last dictation" />
          <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource ColorText}" Opacity="0.7" FontSize="13" TextWrapping="Wrap"
                     Text="Click the words the model got wrong (each word, or just the first and last), type how they should be written, then add the fix. Click an end word again to remove it. Add as many fixes as you need and save them together. This sentence is discarded when you close this window." />
        </StackPanel>
        <Border Grid.Row="1" Margin="0,14,0,0" Padding="10,10,4,4" Background="{DynamicResource ColorBg}" BorderBrush="{DynamicResource ColorDivider}" BorderThickness="1" CornerRadius="8">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <ItemsControl x:Name="WordList" AutomationProperties.Name="Words from the last dictation" KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Cycle">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <ToggleButton Style="{StaticResource WordChip}" Content="{Binding Text}" IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding IsAvailable}" Tag="{Binding}"
                                Click="ActivateWord" PreviewKeyDown="WordKeyDown" AutomationProperties.Name="{Binding Text}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
        <Grid Grid.Row="2" Margin="0,16,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock FontSize="13" Opacity="0.8" Text="Correct spelling" />
            <TextBox x:Name="DesiredBox" Margin="0,6,0,0" Height="34" Padding="9,0" MaxLength="120" TextChanged="DesiredChanged" PreviewKeyDown="DesiredKeyDown"
                     AutomationProperties.Name="Correct spelling" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock FontSize="13" Opacity="0.8" Text="Save for" />
            <ComboBox x:Name="ScopeBox" Margin="0,6,0,0" Height="36" Padding="8,0" SelectedValuePath="Code" IsTextSearchEnabled="True" TextSearch.TextPath="DisplayName"
                      MaxDropDownHeight="300" AutomationProperties.Name="Save for language" SelectionChanged="ScopeChanged">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Foreground="{DynamicResource ColorText}" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <Button x:Name="AddFixButton" Grid.Column="4" VerticalAlignment="Bottom" Height="36" Content="Add fix" Click="AddFix" />
        </Grid>
        <TextBlock x:Name="SelectionHint" Grid.Row="3" Foreground="{DynamicResource ColorAccent300}" FontSize="12" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        <StackPanel x:Name="FixesPanel" Grid.Row="4" Margin="0,12,0,0" Visibility="Collapsed">
          <TextBlock FontSize="13" Opacity="0.8" Text="Fixes to save" />
          <Border Margin="0,6,0,0" Padding="10,4" Background="{DynamicResource ColorBg}" BorderBrush="{DynamicResource ColorDivider}" BorderThickness="1" CornerRadius="8">
            <ScrollViewer MaxHeight="112" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
              <ItemsControl x:Name="FixList" AutomationProperties.Name="Fixes to save">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,3">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding Phrase}" TextTrimming="CharacterEllipsis" />
                        <TextBlock FontSize="12" Opacity="0.6" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <Button Grid.Column="1" Width="28" Height="28" Padding="0" VerticalAlignment="Center" Content="×" FontSize="16" Tag="{Binding}"
                              Background="Transparent" BorderBrush="Transparent" Foreground="{DynamicResource ColorNeutral400}" Click="RemoveFix"
                              AutomationProperties.Name="{Binding RemoveName}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
        </StackPanel>
        <StackPanel Grid.Row="5" Margin="0,12,0,0">
          <TextBlock x:Name="StrengthText" Foreground="{DynamicResource ColorText}" Opacity="0.55" FontSize="12" TextWrapping="Wrap" />
          <TextBlock Margin="0,2,0,0" Foreground="{DynamicResource ColorText}" Opacity="0.55" FontSize="12" TextWrapping="Wrap"
                     Text="Each fix also remembers the words it replaces, so they are corrected after future dictations. The rest of the sentence is not saved, and text already typed into the other app is not changed." />
          <TextBlock x:Name="ErrorText" Margin="0,8,0,0" Foreground="{DynamicResource ColorAccent300}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
          <StackPanel Margin="0,10,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Margin="0,0,8,0" Content="Cancel" Click="CloseWindow" />
            <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Content="Save term" IsDefault="True" Click="Save" />
          </StackPanel>
        </StackPanel>
      </Grid>
      <Grid x:Name="SavedPanel" Grid.Row="1" Margin="22" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
          <TextBlock FontSize="20" FontWeight="SemiBold" Text="Saved to your vocabulary" />
          <TextBlock x:Name="SavedText" Margin="0,8,0,0" FontSize="14" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
          <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource ColorText}" Opacity="0.7" FontSize="13" TextWrapping="Wrap"
                     Text="Future dictations use them. You can review or edit them on the Vocabulary page in Settings." />
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="OpenVocabularyButton" Margin="0,0,8,0" Content="Open vocabulary" Click="OpenVocabulary" />
          <Button x:Name="DoneButton" Style="{StaticResource PrimaryButton}" Content="Done" Click="Done" />
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
