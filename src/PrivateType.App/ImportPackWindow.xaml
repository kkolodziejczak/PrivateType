<Window x:Class="PrivateType.App.ImportPackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import vocabulary pack" Icon="/PrivateType;component/Assets/PrivateType.ready.ico" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="None" UseLayoutRounding="True" AllowsTransparency="True" ShowInTaskbar="False"
        Background="Transparent" Foreground="{DynamicResource ColorText}" FontFamily="{DynamicResource AppFont}">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="FormStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <!-- In a form, a dropdown keeps the same visible field as the text box beside it. -->
      <!-- 29.6 is 37 whole pixels at 125 %: between two row hairlines a 30 field (37.5, drawn as 38) leaves an odd 11 pixels and
           sits a pixel off centre; 37 leaves 6 above and 6 below. -->
      <Style x:Key="FieldFrame" TargetType="Border">
        <Setter Property="Height" Value="29.6" />
        <Setter Property="Background" Value="{DynamicResource ColorBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ColorDivider}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Style.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource ColorNeutral800}" /></Trigger>
        </Style.Triggers>
      </Style>
      <!-- A flat list of phrases with hairlines between them. -->
      <Style x:Key="PhraseRow" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource ColorText}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ListBoxItem">
              <Border x:Name="Row" Padding="0,6" Background="Transparent" BorderBrush="{DynamicResource ColorHairline}" BorderThickness="0,1,0,0">
                <ContentPresenter />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource ColorHairline}" /></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </Window.Resources>
  <Border Margin="8" Background="{DynamicResource ColorSurface}" BorderBrush="{DynamicResource ColorDivider}" BorderThickness="1" CornerRadius="12">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="40" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Border BorderBrush="{DynamicResource ColorHairline}" BorderThickness="0,0,0,1" CornerRadius="11,11,0,0" Background="Transparent" MouseLeftButtonDown="DragWindow">
        <Grid Margin="16,0,8,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="18" Height="18" CornerRadius="4" Background="{DynamicResource ColorKeycap}" BorderBrush="{DynamicResource ColorKeycapEdge}" BorderThickness="0,0,0,2">
              <Ellipse Width="6" Height="6" Fill="{DynamicResource ColorAccent400}" />
            </Border>
            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Text="Import vocabulary pack" />
          </StackPanel>
          <Button Style="{StaticResource GhostButton}" Width="28" Height="28" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Center" Content="×" FontSize="18"
                  IsCancel="True" AutomationProperties.Name="Close" />
        </Grid>
      </Border>

      <StackPanel Grid.Row="1" Margin="24,6,24,14">
        <Border Style="{StaticResource TableRow}" BorderThickness="0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="96" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource RowLabel}" Text="File" />
            <!-- 9 in: where the text of the fields below starts. -->
            <TextBlock x:Name="FileText" Grid.Column="1" Margin="9,0,0,0" Style="{StaticResource RowValue}" FontFamily="{DynamicResource MonoFont}" FontSize="12" TextTrimming="CharacterEllipsis" />
          </Grid>
        </Border>
        <Border Style="{StaticResource TableRow}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="96" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource RowLabel}" Text="Name" />
            <TextBox x:Name="NameBox" Grid.Column="1" Height="29.6" FontSize="13" MaxLength="80" TextChanged="InputChanged" AutomationProperties.Name="Pack name" />
          </Grid>
        </Border>
        <Border Style="{StaticResource TableRow}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="96" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource RowLabel}" Text="Language" />
            <Border Grid.Column="1" Style="{StaticResource FieldFrame}">
              <ComboBox x:Name="ScopeBox" Margin="-1" SelectedValuePath="Code" SelectionChanged="InputChanged"
                        IsTextSearchEnabled="True" TextSearch.TextPath="DisplayName" MaxDropDownHeight="320" AutomationProperties.Name="Pack language">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Foreground="{DynamicResource ColorText}" Text="{Binding DisplayName}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Border>
          </Grid>
        </Border>
        <Border Style="{StaticResource TableRow}">
          <!-- The switch's right edge meets the fields' right edge; its focus ring may reach past it.
               On whole pixels at 125 % the switch stands 7 px in, which is 5.6. -->
          <CheckBox x:Name="EnabledBox" Style="{StaticResource SwitchRow}" Margin="0,0,-5.6,0" MinHeight="32" Content="Use this pack after importing" IsChecked="True"
                    AutomationProperties.Name="Use this pack after importing" />
        </Border>

        <TextBlock x:Name="CountText" Style="{StaticResource GroupLabel}" Margin="0,18,0,4" />
        <ListBox x:Name="PhraseList" MaxHeight="232" ItemContainerStyle="{StaticResource PhraseRow}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Phrases in this pack" />
        <Border BorderBrush="{DynamicResource ColorHairline}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
          <TextBlock Foreground="{DynamicResource ColorNeutral400}" FontSize="12" TextWrapping="Wrap"
                     Text="This copies the phrases locally. It does not link to or update from the file." />
        </Border>
      </StackPanel>

      <!-- Slim footer: a message on the left, the text-button Cancel, then the filled primary action at the right. -->
      <Border Grid.Row="2" Padding="24,10,16,12" BorderBrush="{DynamicResource ColorHairline}" BorderThickness="0,1,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="ErrorText" Margin="0,0,16,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource ColorDanger}" TextWrapping="Wrap"
                     AutomationProperties.LiveSetting="Polite" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Style="{StaticResource GhostButton}" Margin="0,0,8,0" Height="32" Padding="12,0" Content="Cancel" IsCancel="True" />
            <Button x:Name="ImportButton" Style="{StaticResource PrimaryButton}" Height="32" Padding="16,0" Content="Import pack" IsDefault="True" Click="Import" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
