<Window x:Class="PrivateType.App.ChooseVersionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose PrivateType version" Icon="/PrivateType;component/Assets/PrivateType.ready.ico" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" WindowStyle="None" UseLayoutRounding="True" AllowsTransparency="True"
        Background="Transparent" Foreground="{DynamicResource ColorText}" FontFamily="{DynamicResource AppFont}"
        Loaded="FocusSafeChoice">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="FormStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Border Margin="8" Background="{DynamicResource ColorSurface}" BorderBrush="{DynamicResource ColorDivider}" BorderThickness="1" CornerRadius="12">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="40" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <!-- The same title bar as Settings: keycap mark, name, and what this window is for. -->
      <Border Background="{DynamicResource ColorSurface}" BorderBrush="{DynamicResource ColorHairline}" BorderThickness="0,0,0,1" CornerRadius="11,11,0,0" MouseLeftButtonDown="DragWindow">
        <Grid Margin="16,0,8,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="18" Height="18" CornerRadius="4" Background="{DynamicResource ColorKeycap}" BorderBrush="{DynamicResource ColorKeycapEdge}" BorderThickness="0,0,0,2">
              <Ellipse Width="6" Height="6" Fill="{DynamicResource ColorAccent400}" />
            </Border>
            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Text="PrivateType" />
            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource ColorNeutral400}" Text="Choose version" />
          </StackPanel>
          <Button x:Name="CloseButton" Width="28" Height="28" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Center" Content="×" FontSize="18" Style="{StaticResource GhostButton}"
                  Click="KeepOtherCopy" />
        </Grid>
      </Border>
      <StackPanel Grid.Row="1" Margin="24,18,24,22">
        <TextBlock x:Name="TitleBlock" FontSize="15" FontWeight="SemiBold" />
        <!-- The copies as table values, so each stays beside its label; the first shown row draws the top hairline. -->
        <StackPanel Margin="0,14,0,0">
          <Border x:Name="RunningRow" Style="{StaticResource TableRow}">
            <Grid>
              <TextBlock Style="{StaticResource RowLabel}" Text="Running now" />
              <TextBlock x:Name="RunningVersionText" Style="{StaticResource RowValue}" Margin="0,3.2,0,0" FontFamily="{DynamicResource MonoFont}" FontSize="12" HorizontalAlignment="Right" />
            </Grid>
          </Border>
          <Border x:Name="StartupRow" Style="{StaticResource TableRow}">
            <Grid>
              <TextBlock Style="{StaticResource RowLabel}" Text="Starts with Windows" />
              <TextBlock x:Name="RegisteredVersionText" Style="{StaticResource RowValue}" Margin="0,3.2,0,0" FontFamily="{DynamicResource MonoFont}" FontSize="12" HorizontalAlignment="Right" />
            </Grid>
          </Border>
          <Border Style="{StaticResource TableRow}" BorderThickness="0,1,0,1">
            <Grid>
              <TextBlock Style="{StaticResource RowLabel}" Text="You opened" />
              <TextBlock x:Name="CurrentVersionText" Style="{StaticResource RowValue}" Margin="0,3.2,0,0" FontFamily="{DynamicResource MonoFont}" FontSize="12" HorizontalAlignment="Right" Foreground="{DynamicResource ColorText}" />
            </Grid>
          </Border>
        </StackPanel>
        <TextBlock x:Name="ExplanationBlock" Margin="0,12,0,0" FontSize="12" Foreground="{DynamicResource ColorNeutral400}" TextWrapping="Wrap" />
        <!-- Only for a copy too old to be asked to quit. -->
        <Border x:Name="ForcedCloseNotice" Margin="0,14,0,0" Style="{StaticResource NoticeStrip}">
          <DockPanel>
            <ContentControl DockPanel.Dock="Left" Margin="0,1,10,0" VerticalAlignment="Top" Style="{StaticResource WarningMark}" />
            <TextBlock x:Name="ForcedCloseBlock" FontSize="12" TextWrapping="Wrap" />
          </DockPanel>
        </Border>
      </StackPanel>
      <!-- The same slim footer as Settings: the safe choice as text, the change filled at the right. -->
      <Border Grid.Row="2" Padding="24,10,16,12" BorderBrush="{DynamicResource ColorHairline}" BorderThickness="0,1,0,0">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="KeepButton" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Height="32" Padding="12,0" IsCancel="True" Click="KeepOtherCopy" />
          <Button x:Name="UseButton" Style="{StaticResource PrimaryButton}" Height="32" Padding="16,0" Click="UseThisCopy" />
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
