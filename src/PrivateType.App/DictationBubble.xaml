<Window x:Class="PrivateType.App.DictationBubble"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="64" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="True" Focusable="False" ShowActivated="False">
  <Border x:Name="BubbleShell" Background="{DynamicResource ColorSurface}" BorderBrush="{DynamicResource ColorDivider}" BorderThickness="1"
          CornerRadius="32" Padding="13" MouseEnter="ExpandHints" MouseLeave="CollapseHints" MouseLeftButtonDown="StartDrag">
    <Border.ContextMenu>
      <ContextMenu Placement="Right" HorizontalOffset="8" MinWidth="132" Background="{DynamicResource ColorSurface}" BorderBrush="{DynamicResource ColorDivider}" BorderThickness="1" Foreground="{DynamicResource ColorText}" FontFamily="{DynamicResource AppFont}">
        <ContextMenu.Resources><Style TargetType="MenuItem"><Setter Property="Foreground" Value="{DynamicResource ColorText}"/><Setter Property="Padding" Value="14,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem"><Border x:Name="ItemShell" Background="{DynamicResource ColorSurface}" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemShell" Property="Background" Value="{DynamicResource ColorNeutral900}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style><Style TargetType="Separator"><Setter Property="Margin" Value="8,2"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Background="{DynamicResource ColorDivider}"/></ControlTemplate></Setter.Value></Setter></Style></ContextMenu.Resources>
        <MenuItem Header="Settings…" Click="OpenSettings" />
        <MenuItem Header="Quit" Click="Quit" />
      </ContextMenu>
    </Border.ContextMenu>
    <StackPanel>
      <Grid x:Name="BubbleHeader" Height="36">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="36" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border x:Name="IconTile" Grid.Column="0" Width="36" Height="36" Background="Transparent"
                BorderBrush="Transparent" BorderThickness="0" CornerRadius="18">
          <Grid ClipToBounds="False">
            <Ellipse x:Name="RecordingPulseRing" Width="36" Height="36" Opacity="0" Stroke="{DynamicResource ColorAccent}" StrokeThickness="1.5" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
              <Ellipse.RenderTransform>
                <ScaleTransform x:Name="RecordingPulseScale" />
              </Ellipse.RenderTransform>
            </Ellipse>
            <Viewbox Width="30" Height="30" Margin="3">
              <Grid Width="32" Height="32">
                <Path x:Name="IconOutline" Data="{StaticResource DictationBubbleGlyph}" Fill="{DynamicResource ColorAccent800}" Stroke="{DynamicResource ColorDivider}" StrokeThickness="1" />
                <Rectangle x:Name="IconBarOne" Width="2.5" Height="8" RadiusX="1.25" RadiusY="1.25" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="9.6,12,0,0" Fill="{DynamicResource ColorAccent300}" />
                <Rectangle x:Name="IconBarTwo" Width="2.5" Height="13" RadiusX="1.25" RadiusY="1.25" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14.6,9.5,0,0" Fill="{DynamicResource ColorAccent300}" />
                <Rectangle x:Name="IconBarThree" Width="2.5" Height="8" RadiusX="1.25" RadiusY="1.25" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="19.6,12,0,0" Fill="{DynamicResource ColorAccent300}" />
              </Grid>
            </Viewbox>
          </Grid>
        </Border>
        <TextBlock x:Name="StatusTitle" Grid.Column="2" VerticalAlignment="Center" FontFamily="{DynamicResource AppFont}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ColorText}" Text="PrivateType" />
      </Grid>
      <TextBlock x:Name="Hint" FontFamily="{DynamicResource AppFont}" Foreground="{DynamicResource ColorText}" Opacity="0.8"
                 Margin="0,12,0,0" FontSize="13" LineHeight="19" TextWrapping="Wrap" Visibility="Collapsed" />
      <UniformGrid x:Name="WaveformBars" Columns="44" Height="16" Margin="0,12,0,0" Visibility="Collapsed" />
      <ScrollViewer x:Name="TranscriptViewport" Margin="0,10,0,0" MaxHeight="60"
                    VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                    Visibility="Collapsed">
        <TextBlock x:Name="Transcript" FontFamily="{DynamicResource AppFont}" Foreground="{DynamicResource ColorText}" Opacity="0.92"
                   FontSize="14" LineHeight="20" TextWrapping="Wrap" />
      </ScrollViewer>
    </StackPanel>
  </Border>
</Window>
