<Window x:Class="PrivateType.App.DictationBubble"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="64" SizeToContent="Height" WindowStyle="None" UseLayoutRounding="True" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="True" Focusable="False" ShowActivated="False"
        AutomationProperties.Name="PrivateType dictation bubble">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="FormStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <!-- A small raised key at 12 semibold for the one action beside a message. It never takes focus: the bubble mustn't. -->
      <Style x:Key="MessageKey" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Visibility" Value="Collapsed" />
      </Style>
    </ResourceDictionary>
  </Window.Resources>
  <Border x:Name="BubbleShell" Background="Transparent" Padding="0" AutomationProperties.Name="PrivateType dictation bubble">
    <Border.ContextMenu>
      <ContextMenu Placement="Right" HorizontalOffset="8" MinWidth="132" UseLayoutRounding="True" Background="{DynamicResource ColorSurface}" BorderBrush="{DynamicResource ColorDivider}" BorderThickness="1" Foreground="{DynamicResource ColorText}" FontFamily="{DynamicResource AppFont}">
        <ContextMenu.Resources><Style TargetType="MenuItem"><Setter Property="Foreground" Value="{DynamicResource ColorText}"/><Setter Property="Padding" Value="14,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem"><Border x:Name="ItemShell" Background="{DynamicResource ColorSurface}" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemShell" Property="Background" Value="{DynamicResource ColorNeutral900}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ItemShell" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style><Style TargetType="Separator"><Setter Property="Margin" Value="8,2"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Background="{DynamicResource ColorDivider}"/></ControlTemplate></Setter.Value></Setter></Style></ContextMenu.Resources>
        <!-- A plain template: the system one draws a light icon column behind dimmed items and separators. -->
        <ContextMenu.Template><ControlTemplate TargetType="ContextMenu"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="0,4"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/></Border></ControlTemplate></ContextMenu.Template>
        <MenuItem Header="Recent dictations…" Click="OpenHistory" AutomationProperties.Name="Recent dictations" />
        <MenuItem Header="Vocabulary…" Click="OpenVocabulary" AutomationProperties.Name="Vocabulary" />
        <MenuItem x:Name="TeachMenuItem" Header="Teach from last dictation…" Click="OpenTeach" IsEnabled="False" AutomationProperties.Name="Teach from last dictation" />
        <Separator Focusable="False"><Separator.Template><ControlTemplate TargetType="Separator"><Border Height="1" Margin="10,4" Background="{DynamicResource ColorDivider}"/></ControlTemplate></Separator.Template></Separator>
        <MenuItem Header="Settings…" Click="OpenSettings" AutomationProperties.Name="Settings" />
        <MenuItem Header="Quit" Click="Quit" AutomationProperties.Name="Quit" />
      </ContextMenu>
    </Border.ContextMenu>
    <Grid>
      <!-- At rest: the round microphone key. Hovered, a small card under it (or over it, where there is no room below) lists the shortcuts as keys. -->
      <StackPanel x:Name="RestLayer" HorizontalAlignment="Center">
        <Border x:Name="Pill" HorizontalAlignment="Center" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="27" Padding="5">
          <Border x:Name="IconTile" Width="44" Height="44" CornerRadius="22" Background="{DynamicResource ColorKeycap}"
                  BorderBrush="{DynamicResource ColorKeycapEdge}" BorderThickness="0,0,0,3" MouseEnter="EnterRestingKey" MouseLeave="LeaveRestingKey">
            <Grid ClipToBounds="False">
              <Viewbox x:Name="MicrophoneMark" Width="24" Height="24">
                <Grid Width="32" Height="32">
                  <Path x:Name="IconOutline" Data="{StaticResource MicrophoneCapsuleGlyph}" Fill="{DynamicResource ColorText}" />
                  <Path x:Name="IconStand" Data="{StaticResource MicrophoneStandGlyph}" Stroke="{DynamicResource ColorText}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Grid>
              </Viewbox>
            </Grid>
          </Border>
        </Border>
        <Border x:Name="BindingsCard" Margin="0,4,0,0" Padding="10,8" CornerRadius="10" Background="{DynamicResource ColorSurface}" BorderBrush="{DynamicResource ColorDivider}" BorderThickness="1"
                HorizontalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False">
          <StackPanel x:Name="BindingsList" />
        </Border>
      </StackPanel>
      <!-- Active: one caption card. The words dominate; the state is a slim line over them, which is also the handle to drag the card by. -->
      <Border x:Name="Card" AutomationProperties.LiveSetting="Polite" Background="{DynamicResource ColorSurface}" BorderBrush="{DynamicResource ColorDivider}" BorderThickness="1" CornerRadius="12" Padding="12" Visibility="Collapsed">
        <StackPanel>
          <Grid x:Name="CardHeader" Height="18" Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Width="12" Height="12" Margin="0,0,7,0" VerticalAlignment="Center">
              <!-- Listening: a lit dot. Working: the same dot as a ring, breathing. -->
              <Ellipse x:Name="StateDot" Width="10" Height="10" Fill="{DynamicResource ColorAccent}" />
              <Ellipse x:Name="StateRing" Width="10" Height="10" Stroke="{DynamicResource ColorNeutral400}" StrokeThickness="1.6" Visibility="Collapsed" />
              <ContentControl x:Name="WarningGlyph" Style="{StaticResource WarningMark}" Width="12" Height="12" Visibility="Collapsed" />
              <ContentControl x:Name="SuccessGlyph" Style="{StaticResource SuccessMark}" Width="12" Height="12" Visibility="Collapsed" />
            </Grid>
            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis" FontFamily="{DynamicResource AppFont}">
              <Run x:Name="StateWord" FontWeight="SemiBold" Foreground="{DynamicResource ColorText}" /><Run x:Name="StateDetail" Foreground="{DynamicResource ColorNeutral400}" />
            </TextBlock>
            <StackPanel x:Name="WaveformBars" Grid.Column="2" Margin="8,0,0,0" Orientation="Horizontal" VerticalAlignment="Center" Height="20" Visibility="Collapsed" />
          </Grid>
          <TextBlock x:Name="Hint" Margin="0,6,0,0" FontFamily="{DynamicResource AppFont}" Foreground="{DynamicResource ColorNeutral400}"
                     FontSize="13" LineHeight="19" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" Visibility="Collapsed" />
          <ScrollViewer x:Name="TranscriptViewport" Margin="0,6,0,0" MaxHeight="66"
                        VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                        Visibility="Collapsed">
            <TextBlock x:Name="Transcript" AutomationProperties.LiveSetting="Polite" FontFamily="{DynamicResource AppFont}" Foreground="{DynamicResource ColorText}"
                       FontSize="15" LineHeight="22" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" />
          </ScrollViewer>
          <!-- The words of a dictation that wasn't inserted: three lines at most, cut with an ellipsis. Copy takes all of them. -->
          <TextBlock x:Name="HeldWords" Margin="0,6,0,0" Opacity="0.7" FontFamily="{DynamicResource AppFont}" Foreground="{DynamicResource ColorText}"
                     FontSize="15" LineHeight="22" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" Visibility="Collapsed" />
          <StackPanel x:Name="ActionRow" Margin="0,6,0,0" Orientation="Horizontal" Visibility="Collapsed">
            <Button x:Name="HistoryAction" Style="{StaticResource MessageKey}" Content="Recent dictations" Click="OpenHistory" Margin="0,0,6,0" />
            <Button x:Name="CopyAction" Style="{StaticResource MessageKey}" Content="Copy" Click="CopyHeldText" Margin="0,0,6,0" />
            <Button x:Name="MicrophoneAction" Style="{StaticResource MessageKey}" Click="OpenMicrophoneSettings" Margin="0,0,6,0" />
            <Button x:Name="DiagnosticsAction" Style="{StaticResource MessageKey}" Content="Open diagnostics" Click="OpenDiagnostics" Margin="0,0,6,0" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
