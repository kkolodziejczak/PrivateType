<Window x:Class="PrivateType.App.StartupVersionPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose Windows startup version" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Foreground="{DynamicResource ColorText}" FontFamily="{DynamicResource AppFont}"
        Loaded="FocusSafeChoice">
  <Border Margin="8" Background="{DynamicResource ColorSurface}" BorderBrush="{DynamicResource ColorDivider}" BorderThickness="1" CornerRadius="16">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Background="{DynamicResource ColorNeutral900}" CornerRadius="15,15,0,0" MouseLeftButtonDown="DragWindow">
        <Grid Margin="16,0,8,0">
          <TextBlock VerticalAlignment="Center" Opacity=".8" FontSize="13" Text="PrivateType — Windows startup"/>
          <Button Width="28" Height="28" Padding="0" HorizontalAlignment="Right" Content="×" FontSize="18" Background="Transparent" BorderBrush="Transparent" Foreground="{DynamicResource ColorNeutral400}" AutomationProperties.Name="Keep registered version" Click="KeepRegisteredVersion"/>
        </Grid>
      </Border>
      <Border Grid.Row="1" Padding="22" Background="{DynamicResource ColorSurface}" CornerRadius="0,0,14,14">
        <StackPanel>
          <TextBlock FontSize="22" FontWeight="SemiBold" Text="Use this version at startup?"/>
          <TextBlock x:Name="VersionSummary" Margin="0,6,0,0" Opacity=".75" FontSize="14" TextWrapping="Wrap"/>
          <Border Margin="0,16,0,0" Padding="12" Background="{DynamicResource ColorBg}" BorderBrush="{DynamicResource ColorDivider}" BorderThickness="1" CornerRadius="8">
            <TextBlock FontSize="13" TextWrapping="Wrap" Text="You can run either version. Choose whether the version you opened should replace the version currently registered to start with Windows."/>
          </Border>
          <StackPanel Margin="0,22,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="UseButton" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Content="Use this version" Click="UseCurrentVersion"/>
            <Button x:Name="KeepButton" Content="Keep registered version" IsCancel="True" Click="KeepRegisteredVersion"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
