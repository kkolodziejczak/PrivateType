<Window x:Class="PrivateType.App.ModelSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set up PrivateType" Icon="/PrivateType;component/Assets/PrivateType.ready.ico" Width="636" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" WindowStyle="None" UseLayoutRounding="True" AllowsTransparency="True"
        Background="Transparent" Foreground="{DynamicResource ColorText}" FontFamily="{DynamicResource AppFont}">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="FormStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style TargetType="ProgressBar">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ProgressBar">
              <Border x:Name="PART_Track" Background="{DynamicResource ColorNeutral800}" CornerRadius="3">
                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{DynamicResource ColorAccent}" CornerRadius="3" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <!-- One line of the review: a quiet label and its value. Both use one 18 line box, so the 12 label, the 13 value and
           the mono model ID share a baseline. -->
      <Style x:Key="FactLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource ColorNeutral400}" />
        <Setter Property="Margin" Value="0,8,0,0" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
      </Style>
      <Style x:Key="FactValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,8,0,0" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
      </Style>
      <!-- A link out of the app at body size, in the link colour "Read the terms" uses. -->
      <Style x:Key="BodyLink" TargetType="Button" BasedOn="{StaticResource TextLinkButton}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource ColorAccent400}" />
      </Style>
      <!-- The demonstration: a line of dictated text drawn on a tinted strip. It is a picture, not a field. -->
      <Style x:Key="DemoStrip" TargetType="Border">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Background" Value="{DynamicResource ColorBg}" />
      </Style>
      <Style x:Key="DemoLabel" TargetType="TextBlock" BasedOn="{StaticResource GroupLabel}">
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
    </ResourceDictionary>
  </Window.Resources>
  <Border Margin="8" Background="{DynamicResource ColorSurface}" BorderBrush="{DynamicResource ColorDivider}" BorderThickness="1" CornerRadius="12">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="40" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <!-- The same title bar as Settings: keycap mark, name, and what this window is for. -->
      <Border Background="{DynamicResource ColorSurface}" BorderBrush="{DynamicResource ColorHairline}" BorderThickness="0,0,0,1" CornerRadius="11,11,0,0" MouseLeftButtonDown="DragWindow">
        <Grid Margin="16,0,8,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="18" Height="18" CornerRadius="4" Background="{DynamicResource ColorKeycap}" BorderBrush="{DynamicResource ColorKeycapEdge}" BorderThickness="0,0,0,2">
              <Ellipse Width="6" Height="6" Fill="{DynamicResource ColorAccent400}" />
            </Border>
            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Text="PrivateType" />
            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource ColorNeutral400}" Text="local model setup" />
          </StackPanel>
          <Button Width="28" Height="28" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Center" Content="×" FontSize="18" Style="{StaticResource GhostButton}"
                  Click="CloseWindow" AutomationProperties.Name="Close" />
        </Grid>
      </Border>

      <!-- After step 1, the chosen experience heads every state: its finished line, its answer, and the model behind it. -->
      <Border x:Name="ChosenHeader" Grid.Row="1" Padding="24,12" Background="{DynamicResource ColorBg}" BorderBrush="{DynamicResource ColorHairline}" BorderThickness="0,0,0,1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Width="220" Height="28" Padding="10,0" CornerRadius="4" Background="{DynamicResource ColorNeutral900}">
            <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource ColorNeutral400}" TextTrimming="CharacterEllipsis" x:Name="ChosenPhraseText" />
          </Border>
          <StackPanel Grid.Column="2" VerticalAlignment="Center">
            <TextBlock x:Name="ChosenAnswerText" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="ChosenModelText" Margin="0,1,0,0" FontSize="12" Foreground="{DynamicResource ColorNeutral400}" Typography.NumeralAlignment="Tabular" />
          </StackPanel>
          <!-- Back to step 1, where the choice was made; the consent clears only if the choice changes. -->
          <Button x:Name="ChangeLink" Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource BodyLink}" Content="Change"
                  Click="ChangeChoice" AutomationProperties.Name="Change how your words appear" />
        </Grid>
      </Border>

      <!-- The content pane: one step's question at a time. -->
      <StackPanel Grid.Row="2" Margin="24,18,24,20">
        <!-- Announced when it changes, so a screen reader hears each new step. -->
        <TextBlock x:Name="HeadingText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />

        <!-- Step 1: how the words should appear, as two answers led by a picture of each behaviour. -->
        <ItemsControl x:Name="ModelChoices" Margin="0,16,-12,0" KeyboardNavigation.TabNavigation="Continue" KeyboardNavigation.DirectionalNavigation="Contained">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <RadioButton Margin="0,0,12,0" Foreground="{DynamicResource ColorText}" GroupName="SetupModel" IsChecked="{Binding IsChosen, Mode=TwoWay}" Cursor="Hand"
                           FocusVisualStyle="{x:Null}" AutomationProperties.Name="{Binding SpokenName}">
                <RadioButton.Template>
                  <ControlTemplate TargetType="RadioButton">
                    <Grid>
                      <Border x:Name="Card" Padding="16,14,16,16" CornerRadius="8" Background="Transparent" BorderBrush="{DynamicResource ColorDivider}" BorderThickness="1">
                        <StackPanel>
                          <!-- The same phrase at the same two moments: while the shortcut is held, and after it is let go. -->
                          <Grid>
                            <TextBlock Style="{StaticResource DemoLabel}" Text="STILL HOLDING" />
                            <Border Margin="0,0,0,6" HorizontalAlignment="Right" Style="{StaticResource StatusChip}" Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVisibility}}">
                              <TextBlock FontWeight="SemiBold" Text="RECOMMENDED" />
                            </Border>
                          </Grid>
                          <Border Style="{StaticResource DemoStrip}">
                            <Grid VerticalAlignment="Center">
                              <StackPanel Orientation="Horizontal" Visibility="{Binding HasHeldText, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock FontSize="13" Text="{Binding Facts.HeldText}" />
                                <Rectangle Width="2" Height="16" Margin="3,0,0,0" VerticalAlignment="Center" Fill="{DynamicResource ColorAccent}" />
                              </StackPanel>
                              <TextBlock FontSize="13" Foreground="{DynamicResource ColorNeutral600}" Text="Appears after you let go" Visibility="{Binding WaitsForRelease, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                          </Border>
                          <TextBlock Margin="0,12,0,6" Style="{StaticResource DemoLabel}" Text="AFTER YOU LET GO" />
                          <Border Style="{StaticResource DemoStrip}">
                            <TextBlock VerticalAlignment="Center" FontSize="13" Text="{Binding Phrase}" TextTrimming="CharacterEllipsis" />
                          </Border>
                          <!-- The answer, with its radio mark: this is what is chosen. -->
                          <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="16" />
                              <ColumnDefinition Width="10" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="16" Height="16" Margin="0,2,0,0" VerticalAlignment="Top">
                              <Ellipse x:Name="Ring" Stroke="{DynamicResource ColorNeutral600}" StrokeThickness="1.5" />
                              <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource ColorAccent}" Visibility="Hidden" />
                            </Grid>
                            <TextBlock Grid.Column="2" FontSize="15" FontWeight="SemiBold" Text="{Binding Facts.Appears}" TextWrapping="Wrap" />
                          </Grid>
                          <StackPanel Margin="26,8,0,0">
                            <TextBlock FontSize="13" Text="{Binding Facts.Languages}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,2,0,0" FontSize="13" Text="{Binding Facts.LanguageChoice}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,10,0,0" FontSize="12" Foreground="{DynamicResource ColorNeutral400}" Typography.NumeralAlignment="Tabular" Text="{Binding Caption}" />
                          </StackPanel>
                        </StackPanel>
                      </Border>
                      <!-- Focus is a ring outside the card with a gap, so it never reads as the chosen card's own edge. -->
                      <Border x:Name="FocusRing" Margin="-4" BorderBrush="{DynamicResource ColorAccent}" BorderThickness="2" CornerRadius="12" Visibility="Hidden" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="{DynamicResource ColorHairline}" /></Trigger>
                      <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Card" Property="Background" Value="{DynamicResource ColorNeutral900}" />
                        <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource ColorAccent}" />
                        <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                        <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource ColorAccent}" />
                      </Trigger>
                      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Visibility" Value="Visible" /></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </RadioButton.Template>
              </RadioButton>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Step 2: the model behind the answer, what will be downloaded, from where, where it stays and under which terms; then the consent. -->
        <StackPanel x:Name="ReviewPane" Margin="0,8,0,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="96" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Style="{StaticResource FactLabel}" Text="Languages" />
            <TextBlock x:Name="LanguagesText" Grid.Column="1" Style="{StaticResource FactValue}" />
            <TextBlock Grid.Row="1" Style="{StaticResource FactLabel}" Text="Language" />
            <TextBlock x:Name="LanguageChoiceText" Grid.Row="1" Grid.Column="1" Style="{StaticResource FactValue}" />
            <TextBlock Grid.Row="2" Style="{StaticResource FactLabel}" Text="Your phrases" />
            <TextBlock x:Name="PhrasesText" Grid.Row="2" Grid.Column="1" Style="{StaticResource FactValue}" />
            <TextBlock Grid.Row="3" Style="{StaticResource FactLabel}" Text="Download" />
            <TextBlock x:Name="SizeText" Grid.Row="3" Grid.Column="1" Style="{StaticResource FactValue}" Typography.NumeralAlignment="Tabular" />
            <TextBlock Grid.Row="4" Style="{StaticResource FactLabel}" Text="From" />
            <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource FactValue}" Text="NVIDIA on Hugging Face" />
            <TextBlock Grid.Row="5" Style="{StaticResource FactLabel}" Text="Kept" />
            <TextBlock x:Name="StorageNoticeText" Grid.Row="5" Grid.Column="1" Style="{StaticResource FactValue}" />
            <TextBlock Grid.Row="6" Style="{StaticResource FactLabel}" Text="Later" />
            <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource FactValue}" Text="Change or delete models in Settings → Model" />
            <TextBlock Grid.Row="7" Style="{StaticResource FactLabel}" Text="License" />
            <!-- The link is its own keyboard stop; following it leaves the choice and the checkbox as they are. -->
            <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource FactValue}"><Run x:Name="LicenseNameText" /><Run Text="    " /><Hyperlink x:Name="ModelTermsLink"
                Foreground="{DynamicResource ColorAccent400}" RequestNavigate="OpenModelTerms" ToolTip="Open the model terms in your default browser"><Run Text="Read the terms" /></Hyperlink></TextBlock>
            <TextBlock Grid.Row="8" Style="{StaticResource FactLabel}" Text="Model" />
            <TextBlock x:Name="ModelIdText" Grid.Row="8" Grid.Column="1" Style="{StaticResource FactValue}" FontFamily="{DynamicResource MonoFont}" FontSize="12" Foreground="{DynamicResource ColorNeutral400}" />
          </Grid>
          <CheckBox x:Name="TermsCheckBox" Margin="0,16,0,0" VerticalContentAlignment="Top" Checked="TermsChanged" Unchecked="TermsChanged"><TextBlock x:Name="TermsText" FontSize="13" TextWrapping="Wrap" /></CheckBox>
          <!-- Why Download waits, under the box it waits for. -->
          <TextBlock x:Name="DownloadReasonText" Margin="28,4,0,0" FontSize="12" Foreground="{DynamicResource ColorNeutral400}" Text="Accept the terms to download." />
        </StackPanel>

        <!-- Downloading, then checking: the work under way, in the same place. -->
        <StackPanel x:Name="ProgressPane" Margin="0,16,0,0">
          <TextBlock x:Name="ProgressAmountText" FontSize="15" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
          <ProgressBar x:Name="ProgressBar" Margin="0,10,0,0" Height="6" Minimum="0" Maximum="100" />
          <TextBlock x:Name="ProgressNextText" Margin="0,10,0,0" FontSize="13" Foreground="{DynamicResource ColorNeutral400}" TextWrapping="Wrap"
                     Text="Next, the files are checked. Then dictation is ready." />
          <!-- Checking: no bar, since nothing can be measured. What is done carries the tick; what is under way breathes. -->
          <StackPanel x:Name="CheckingPanel" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
              <ContentControl Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" Style="{StaticResource SuccessMark}" />
              <TextBlock x:Name="DownloadedText" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
            </StackPanel>
            <TextBlock x:Name="CheckingText" Margin="0,10,0,0" FontSize="13" Foreground="{DynamicResource ColorNeutral400}" Text="Checking the files…"
                       AutomationProperties.LiveSetting="Polite" />
          </StackPanel>
          <TextBlock x:Name="ProgressModelText" Margin="0,16,0,0" FontFamily="{DynamicResource MonoFont}" FontSize="12" Foreground="{DynamicResource ColorNeutral600}" />
        </StackPanel>

        <!-- A stopped state: why, and what to do. -->
        <StackPanel x:Name="StoppedPane" Margin="0,6,0,0">
          <TextBlock x:Name="StatusText" FontSize="13" Foreground="{DynamicResource ColorNeutral400}" TextWrapping="Wrap" />
          <!-- What to do next, in the text colour. -->
          <TextBlock x:Name="NextStepText" Margin="0,10,0,0" FontSize="13" TextWrapping="Wrap" />
          <!-- A stopped engine: where to get what it needs, under the step that names it. -->
          <Button x:Name="VisualCppLink" Margin="0,8,0,0" Style="{StaticResource BodyLink}" Click="GetVisualCppRedistributable"
                  ToolTip="Open Microsoft's download page in your default browser" />
          <!-- The system's own words for a failure: labelled, quieter than the explanation, and selectable so it can be copied. -->
          <StackPanel x:Name="FailureDetailPanel">
            <TextBlock Style="{StaticResource GroupLabel}" Margin="0,20,0,6" Text="DETAILS" />
            <!-- A 16 line box is 20 whole pixels at 125 %, so every wrapped line sits the same distance below the last. -->
            <TextBox x:Name="FailureDetailText" Padding="0" FontFamily="{DynamicResource MonoFont}" FontSize="12" TextBlock.LineHeight="16" TextBlock.LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource ColorNeutral600}" Background="Transparent"
                     BorderThickness="0" IsReadOnly="True" TextWrapping="Wrap" AutomationProperties.Name="Error details">
              <TextBox.Template>
                <ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" Margin="-2,0" /></ControlTemplate>
              </TextBox.Template>
            </TextBox>
          </StackPanel>
        </StackPanel>
      </StackPanel>
      <!-- The same slim footer as Settings: a note on the left, the secondary action as text, the primary filled at the right. -->
      <Border Grid.Row="3" Padding="16,10,16,12" BorderBrush="{DynamicResource ColorHairline}" BorderThickness="0,1,0,0">
        <Grid>
          <!-- Lifted 2, like the text on a key above its edge, so the note shares a line with Quit PrivateType. -->
          <TextBlock x:Name="FooterNoteText" Margin="8,0,0,2" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource ColorNeutral400}" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="QuitButton" Style="{StaticResource GhostButton}" Height="32" Padding="12,0" Content="Quit PrivateType" Click="Quit" />
            <Button x:Name="CheckAgainButton" Margin="8,0,0,0" Height="32" Padding="16,0" Click="CheckAgain" />
            <Button x:Name="GetZipButton" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Height="32" Padding="16,0" Click="GetCompleteZip" />
            <Button x:Name="ContinueButton" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Height="32" Padding="16,0" Click="Continue" />
            <Button x:Name="DownloadButton" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Height="32" Padding="16,0" IsEnabled="False" Click="Download" />
            <Button x:Name="DownloadAgainButton" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Height="32" Padding="16,0" Click="DownloadAgain" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
