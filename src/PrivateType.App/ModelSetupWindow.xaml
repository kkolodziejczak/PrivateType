<Window x:Class="PrivateType.App.ModelSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set up PrivateType" Icon="/PrivateType;component/Assets/PrivateType.ready.ico" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Foreground="{DynamicResource ColorText}" FontFamily="{DynamicResource AppFont}">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="FormStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style TargetType="ProgressBar">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ProgressBar">
              <Border x:Name="PART_Track" Background="{DynamicResource ColorNeutral800}" CornerRadius="2">
                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{DynamicResource ColorAccent}" CornerRadius="2" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <!-- Supporting lines under the heading and the table. -->
      <Style x:Key="FinePrint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource ColorNeutral400}" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>
    </ResourceDictionary>
  </Window.Resources>
  <Border Margin="8" Background="{DynamicResource ColorSurface}" BorderBrush="{DynamicResource ColorDivider}" BorderThickness="1" CornerRadius="12">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="40" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <!-- The same title bar as Settings: keycap mark, name, and what this window is for. -->
      <Border Background="{DynamicResource ColorSurface}" BorderBrush="{DynamicResource ColorHairline}" BorderThickness="0,0,0,1" CornerRadius="11,11,0,0" MouseLeftButtonDown="DragWindow">
        <Grid Margin="16,0,8,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="18" Height="18" CornerRadius="4" Background="{DynamicResource ColorKeycap}" BorderBrush="{DynamicResource ColorKeycapEdge}" BorderThickness="0,0,0,2">
              <Ellipse Width="6" Height="6" Fill="{DynamicResource ColorAccent400}" />
            </Border>
            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Text="PrivateType" />
            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource ColorNeutral400}" Text="local model setup" />
          </StackPanel>
          <Button Width="28" Height="28" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Center" Content="×" FontSize="18" Style="{StaticResource GhostButton}"
                  Click="CloseWindow" AutomationProperties.Name="Close" />
        </Grid>
      </Border>
      <StackPanel Grid.Row="1" Margin="24,18,24,20">
        <TextBlock x:Name="HeadingText" FontSize="15" FontWeight="SemiBold" Text="Download local dictation" />
        <TextBlock x:Name="StatusText" Margin="0,4,0,0" FontSize="13" Foreground="{DynamicResource ColorNeutral400}" TextWrapping="Wrap" Text="Download the local speech model before using dictation." />
        <StackPanel x:Name="ConsentPanel">
          <TextBlock Style="{StaticResource GroupLabel}" Margin="0,18,0,6" Text="SPEECH MODEL" />
          <!-- The choices are table rows: the chosen one carries the accent bar, like the current page in the Settings rail. -->
          <Border BorderBrush="{DynamicResource ColorHairline}" BorderThickness="0,0,0,1">
            <ItemsControl x:Name="ModelChoices" KeyboardNavigation.TabNavigation="Continue">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <RadioButton Foreground="{DynamicResource ColorText}" GroupName="SetupModel" IsChecked="{Binding IsChosen, Mode=TwoWay}" Cursor="Hand"
                               FocusVisualStyle="{x:Null}" AutomationProperties.Name="{Binding Name}">
                    <RadioButton.Template>
                      <ControlTemplate TargetType="RadioButton">
                        <Grid>
                          <Border x:Name="Row" Background="Transparent" BorderBrush="{DynamicResource ColorHairline}" BorderThickness="0,1,0,0">
                            <Grid Margin="14,10,12,11">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>
                              <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                              </Grid.RowDefinitions>
                              <Grid Width="16" Height="16" VerticalAlignment="Center">
                                <Ellipse x:Name="Ring" Stroke="{DynamicResource ColorNeutral600}" StrokeThickness="1.5" />
                                <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource ColorAccent}" Visibility="Hidden" />
                              </Grid>
                              <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding Name}" />
                                <Border Margin="8,0,0,0" Padding="5,1,5,2" CornerRadius="3" VerticalAlignment="Center" BorderBrush="{DynamicResource ColorNeutral800}" BorderThickness="1"
                                        Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVisibility}}">
                                  <TextBlock FontFamily="{DynamicResource MonoFont}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource ColorNeutral400}" Text="RECOMMENDED" />
                                </Border>
                              </StackPanel>
                              <TextBlock Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Center" FontFamily="{DynamicResource MonoFont}" FontSize="12"
                                         Foreground="{DynamicResource ColorNeutral400}" Text="{Binding Size}" />
                              <TextBlock Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource ColorNeutral400}"
                                         Text="{Binding Summary}" TextWrapping="Wrap" />
                            </Grid>
                          </Border>
                          <Border x:Name="Bar" Width="2" HorizontalAlignment="Left" Background="{DynamicResource ColorAccent}" Visibility="Hidden" />
                          <Border x:Name="FocusRing" BorderBrush="{DynamicResource ColorAccent}" BorderThickness="1" CornerRadius="2" Visibility="Hidden" />
                        </Grid>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource ColorHairline}" /></Trigger>
                          <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource ColorNeutral900}" />
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource ColorAccent}" />
                          </Trigger>
                          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Visibility" Value="Visible" /></Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </RadioButton.Template>
                  </RadioButton>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
          <TextBlock x:Name="ModelAdviceText" Margin="0,10,0,0" Style="{StaticResource FinePrint}"
                     Text="Choose Nemotron for live words while you speak, vocabulary boosting, or Asian languages." />
          <TextBlock Margin="0,16,0,0" FontSize="12" Foreground="{DynamicResource ColorNeutral400}" TextWrapping="Wrap">
            <Run x:Name="ModelTermsName" Text="Model terms: " /><Hyperlink x:Name="ModelTermsLink" Foreground="{DynamicResource ColorAccent400}" RequestNavigate="OpenModelTerms" ToolTip="Open the model terms in your default browser"><Run x:Name="ModelTermsLinkText" FontFamily="{DynamicResource MonoFont}" /></Hyperlink>
          </TextBlock>
          <CheckBox x:Name="TermsCheckBox" Margin="0,10,0,0" Checked="TermsChanged" Unchecked="TermsChanged"><TextBlock x:Name="TermsText" FontSize="13" TextWrapping="Wrap" /></CheckBox>
          <TextBlock Margin="0,10,0,0" Style="{StaticResource FinePrint}" Text="Both download from NVIDIA on Hugging Face. You can download the other model, switch, or delete models later in Settings → Model." />
        </StackPanel>
        <ProgressBar x:Name="ProgressBar" Margin="0,18,0,0" Height="4" Minimum="0" Maximum="100" Visibility="Collapsed" />
        <!-- Holds no line when there is nothing to say, so the consent state has no gap. -->
        <TextBlock x:Name="ProgressCaption" Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource ColorNeutral400}" TextWrapping="Wrap">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Style.Triggers>
                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <TextBlock x:Name="StorageNoticeText" Margin="0,14,0,0" FontSize="12" Foreground="{DynamicResource ColorNeutral600}" TextWrapping="Wrap" />
        <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource ColorNeutral600}" TextWrapping="Wrap" Text="The model stays on this computer. Your voice is processed locally." />
      </StackPanel>
      <!-- The same slim footer as Settings: the secondary action as text, the primary filled at the right. -->
      <Border Grid.Row="2" Padding="24,10,16,12" BorderBrush="{DynamicResource ColorHairline}" BorderThickness="0,1,0,0">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="CancelButton" Style="{StaticResource GhostButton}" Margin="0,0,6,0" Padding="12,6" Content="Cancel" Click="Cancel" />
          <Button x:Name="RetryButton" Style="{StaticResource PrimaryButton}" Padding="16,6" Content="Retry" Visibility="Collapsed" Click="Retry" />
          <Button x:Name="DownloadButton" Style="{StaticResource PrimaryButton}" Padding="16,6" Content="Download model" IsEnabled="False" Click="Download" />
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
