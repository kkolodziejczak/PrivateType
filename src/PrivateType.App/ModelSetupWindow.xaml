<Window x:Class="PrivateType.App.ModelSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PrivateType.App"
        Title="Set up PrivateType" Icon="/PrivateType;component/Assets/PrivateType.ready.ico" Width="636" Height="536"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" WindowStyle="None" UseLayoutRounding="True" AllowsTransparency="True"
        Background="Transparent" Foreground="{DynamicResource ColorText}" FontFamily="{DynamicResource AppFont}">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="FormStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style TargetType="ProgressBar">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ProgressBar">
              <Border x:Name="PART_Track" Background="{DynamicResource ColorNeutral800}" CornerRadius="3">
                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{DynamicResource ColorAccent}" CornerRadius="3" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <!-- One line of the review: a quiet label and its value. Both use one 18 line box, so the 12 label, the 13 value and
           the mono model ID share a baseline. -->
      <Style x:Key="FactLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource ColorNeutral400}" />
        <Setter Property="Margin" Value="0,8,0,0" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
      </Style>
      <Style x:Key="FactValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,8,0,0" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
      </Style>
      <!-- A link out of the app at body size, in the link colour "Read the terms" uses. -->
      <Style x:Key="BodyLink" TargetType="Button" BasedOn="{StaticResource TextLinkButton}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource ColorAccent400}" />
      </Style>
    </ResourceDictionary>
  </Window.Resources>
  <Border Margin="8" Background="{DynamicResource ColorSurface}" BorderBrush="{DynamicResource ColorDivider}" BorderThickness="1" CornerRadius="12">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="40" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="136" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <!-- The same title bar as Settings: keycap mark, name, and what this window is for. -->
      <Border Grid.ColumnSpan="2" Background="{DynamicResource ColorSurface}" BorderBrush="{DynamicResource ColorHairline}" BorderThickness="0,0,0,1" CornerRadius="11,11,0,0" MouseLeftButtonDown="DragWindow">
        <Grid Margin="16,0,8,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="18" Height="18" CornerRadius="4" Background="{DynamicResource ColorKeycap}" BorderBrush="{DynamicResource ColorKeycapEdge}" BorderThickness="0,0,0,2">
              <Ellipse Width="6" Height="6" Fill="{DynamicResource ColorAccent400}" />
            </Border>
            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Text="PrivateType" />
            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource ColorNeutral400}" Text="local model setup" />
          </StackPanel>
          <Button Width="28" Height="28" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Center" Content="×" FontSize="18" Style="{StaticResource GhostButton}"
                  Click="CloseWindow" AutomationProperties.Name="Close" />
        </Grid>
      </Border>
      <!-- The rail: where the person is in setup and what is left. It shows position only and can't be clicked. -->
      <Border Grid.Row="1" Grid.RowSpan="2" Background="{DynamicResource ColorBg}" BorderBrush="{DynamicResource ColorHairline}" BorderThickness="0,0,1,0" CornerRadius="0,0,0,11">
        <DockPanel Margin="16,20,16,20">
          <TextBlock DockPanel.Dock="Bottom" FontSize="12" Foreground="{DynamicResource ColorNeutral400}" TextWrapping="Wrap" Text="Your voice is processed on this computer." />
          <StackPanel>
            <TextBlock x:Name="BeforeSetupLabel" Style="{StaticResource GroupLabel}" Margin="0,0,0,10" Text="BEFORE SETUP" Visibility="Collapsed" />
            <ItemsControl x:Name="RailSteps" Focusable="False" AutomationProperties.LiveSetting="Polite">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type local:SetupRailStep}">
                  <Grid Margin="-16,0,0,0" AutomationProperties.Name="{Binding SpokenName}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="16" />
                      <ColumnDefinition Width="20" />
                      <ColumnDefinition Width="10" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!-- The current step carries the accent bar at the rail's edge, like the current page in Settings. -->
                    <Border x:Name="Bar" Width="2" HorizontalAlignment="Left" CornerRadius="1" Background="{DynamicResource ColorAccent}" Visibility="Hidden" />
                    <!-- Joins this step's mark to the next one's, with the same gap at both ends (2.4 is 3 whole pixels at 125 %). -->
                    <Rectangle x:Name="Joiner" Grid.Column="1" Grid.RowSpan="2" Width="1" Margin="0,22.4,0,2.4" HorizontalAlignment="Center" Fill="{DynamicResource ColorNeutral800}" />
                    <Grid Grid.Column="1" Width="20" Height="20" VerticalAlignment="Top">
                      <Ellipse x:Name="Disc" Fill="{DynamicResource ColorBg}" Stroke="{DynamicResource ColorNeutral800}" StrokeThickness="1" />
                      <TextBlock x:Name="Number" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"
                                 Foreground="{DynamicResource ColorNeutral600}" Typography.NumeralAlignment="Tabular" Text="{Binding Number}" />
                      <Path x:Name="Tick" Data="M6,10.5 L8.8,13.2 L14,7.2" Stroke="{DynamicResource ColorNeutral400}" StrokeThickness="1.6" StrokeLineJoin="Round"
                            StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
                      <ContentControl x:Name="Warning" Width="20" Height="20" Style="{StaticResource WarningMark}" Foreground="{DynamicResource ColorDanger}" Visibility="Collapsed" />
                    </Grid>
                    <TextBlock x:Name="Label" Grid.Column="3" Margin="0,1,0,0" FontSize="13" Foreground="{DynamicResource ColorNeutral600}" TextWrapping="Wrap" Text="{Binding Label}" />
                    <Border x:Name="Gap" Grid.Row="1" Grid.ColumnSpan="4" Height="16" />
                  </Grid>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsLast}" Value="True">
                      <Setter TargetName="Joiner" Property="Visibility" Value="Collapsed" />
                      <Setter TargetName="Gap" Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="{x:Static local:SetupRailState.Done}">
                      <Setter TargetName="Number" Property="Visibility" Value="Collapsed" />
                      <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                      <Setter TargetName="Disc" Property="Fill" Value="{DynamicResource ColorNeutral900}" />
                      <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource ColorNeutral400}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="{x:Static local:SetupRailState.Current}">
                      <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                      <Setter TargetName="Disc" Property="Fill" Value="{DynamicResource ColorAccent}" />
                      <Setter TargetName="Disc" Property="Stroke" Value="{DynamicResource ColorAccent}" />
                      <Setter TargetName="Number" Property="Foreground" Value="{DynamicResource ColorAccentText}" />
                      <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource ColorText}" />
                      <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="{x:Static local:SetupRailState.Stopped}">
                      <Setter TargetName="Disc" Property="Visibility" Value="Collapsed" />
                      <Setter TargetName="Number" Property="Visibility" Value="Collapsed" />
                      <Setter TargetName="Warning" Property="Visibility" Value="Visible" />
                      <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource ColorDanger}" />
                      <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="{x:Static local:SetupRailState.Needed}">
                      <Setter TargetName="Disc" Property="Visibility" Value="Collapsed" />
                      <Setter TargetName="Number" Property="Visibility" Value="Collapsed" />
                      <Setter TargetName="Warning" Property="Visibility" Value="Visible" />
                      <Setter TargetName="Warning" Property="Foreground" Value="{DynamicResource ColorWarning}" />
                      <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource ColorText}" />
                      <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </DockPanel>
      </Border>
      <!-- The content pane: one step's question at a time, in the same frame. -->
      <Grid Grid.Row="1" Grid.Column="1" Margin="24,18,24,20">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="HeadingText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />

        <!-- Step 1: which model, and nothing else. -->
        <Border x:Name="ChoosePane" Grid.Row="1" Margin="0,14,0,0" VerticalAlignment="Top" BorderBrush="{DynamicResource ColorHairline}" BorderThickness="0,0,0,1">
          <!-- The choices are table rows: the chosen one carries the accent bar, like the current page in the Settings rail. -->
          <ItemsControl x:Name="ModelChoices" KeyboardNavigation.TabNavigation="Continue">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <RadioButton Foreground="{DynamicResource ColorText}" GroupName="SetupModel" IsChecked="{Binding IsChosen, Mode=TwoWay}" Cursor="Hand"
                             FocusVisualStyle="{x:Null}" AutomationProperties.Name="{Binding ShortName}">
                  <RadioButton.Template>
                    <ControlTemplate TargetType="RadioButton">
                      <Grid>
                        <Border x:Name="Row" Background="Transparent" BorderBrush="{DynamicResource ColorHairline}" BorderThickness="0,1,0,0">
                          <Grid Margin="14,12,12,13">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="16" />
                              <ColumnDefinition Width="12" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                              <RowDefinition Height="Auto" />
                              <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Width="16" Height="16" VerticalAlignment="Center">
                              <Ellipse x:Name="Ring" Stroke="{DynamicResource ColorNeutral600}" StrokeThickness="1.5" />
                              <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource ColorAccent}" Visibility="Hidden" />
                            </Grid>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                              <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Text="{Binding ShortName}" />
                              <Border Margin="8,0,0,0" Style="{StaticResource StatusChip}" Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock FontWeight="SemiBold" Text="RECOMMENDED" />
                              </Border>
                            </StackPanel>
                            <TextBlock Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13" Typography.NumeralAlignment="Tabular"
                                       Foreground="{DynamicResource ColorNeutral400}" Text="{Binding Size}" />
                            <!-- The reason to pick it first, then the same two facts for each model, so the difference reads across the rows. -->
                            <StackPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Margin="0,6,0,0">
                              <TextBlock FontSize="13" Text="{Binding Facts.Lead}" TextWrapping="Wrap" />
                              <TextBlock Margin="0,4,0,0" FontSize="13" Foreground="{DynamicResource ColorNeutral400}" Text="{Binding Facts.Languages}" TextWrapping="Wrap" />
                              <TextBlock Margin="0,2,0,0" FontSize="13" Foreground="{DynamicResource ColorNeutral400}" Text="{Binding Facts.Phrases}" TextWrapping="Wrap" />
                            </StackPanel>
                          </Grid>
                        </Border>
                        <!-- Starts under the row's top hairline, where the row's fill starts. -->
                        <Border x:Name="Bar" Width="2" Margin="0,1,0,0" HorizontalAlignment="Left" Background="{DynamicResource ColorAccent}" Visibility="Hidden" />
                        <!-- Inset inside the row, clear of its hairline and of the next row's accent bar, so two blue strokes never meet. -->
                        <Border x:Name="FocusRing" Margin="4,4,4,3" BorderBrush="{DynamicResource ColorAccent}" BorderThickness="2" CornerRadius="4" Visibility="Hidden" />
                      </Grid>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource ColorHairline}" /></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                          <Setter TargetName="Row" Property="Background" Value="{DynamicResource ColorNeutral900}" />
                          <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                          <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                          <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource ColorAccent}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Visibility" Value="Visible" /></Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </RadioButton.Template>
                </RadioButton>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>

        <!-- Step 2: what will be downloaded, from where, where it stays and under which terms; then the consent. -->
        <StackPanel x:Name="ReviewPane" Grid.Row="1" Margin="0,8,0,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="96" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Style="{StaticResource FactLabel}" Text="Download" />
            <TextBlock x:Name="SizeText" Grid.Column="1" Style="{StaticResource FactValue}" Typography.NumeralAlignment="Tabular" />
            <TextBlock Grid.Row="1" Style="{StaticResource FactLabel}" Text="From" />
            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource FactValue}" Text="NVIDIA on Hugging Face" />
            <TextBlock Grid.Row="2" Style="{StaticResource FactLabel}" Text="Kept" />
            <TextBlock x:Name="StorageNoticeText" Grid.Row="2" Grid.Column="1" Style="{StaticResource FactValue}" />
            <TextBlock Grid.Row="3" Style="{StaticResource FactLabel}" Text="Later" />
            <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource FactValue}" Text="Change or delete models in Settings → Model" />
            <TextBlock Grid.Row="4" Style="{StaticResource FactLabel}" Text="License" />
            <!-- The link is its own keyboard stop; following it leaves the choice and the checkbox as they are. -->
            <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource FactValue}"><Run x:Name="LicenseNameText" /><Run Text="    " /><Hyperlink x:Name="ModelTermsLink"
                Foreground="{DynamicResource ColorAccent400}" RequestNavigate="OpenModelTerms" ToolTip="Open the model terms in your default browser"><Run Text="Read the terms" /></Hyperlink></TextBlock>
            <TextBlock Grid.Row="5" Style="{StaticResource FactLabel}" Text="Model" />
            <TextBlock x:Name="ModelIdText" Grid.Row="5" Grid.Column="1" Style="{StaticResource FactValue}" FontFamily="{DynamicResource MonoFont}" FontSize="12" Foreground="{DynamicResource ColorNeutral400}" />
          </Grid>
          <CheckBox x:Name="TermsCheckBox" Margin="0,16,0,0" VerticalContentAlignment="Top" Checked="TermsChanged" Unchecked="TermsChanged"><TextBlock x:Name="TermsText" FontSize="13" TextWrapping="Wrap" /></CheckBox>
          <!-- Why Download waits, under the box it waits for. -->
          <TextBlock x:Name="DownloadReasonText" Margin="28,4,0,0" FontSize="12" Foreground="{DynamicResource ColorNeutral400}" Text="Accept the terms to download." />
        </StackPanel>

        <!-- Step 2 while downloading, and step 3 while checking: the work under way, in the same place. -->
        <StackPanel x:Name="ProgressPane" Grid.Row="1" Margin="0,16,0,0">
          <TextBlock x:Name="ProgressAmountText" FontSize="15" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
          <ProgressBar x:Name="ProgressBar" Margin="0,10,0,0" Height="6" Minimum="0" Maximum="100" />
          <TextBlock x:Name="ProgressNextText" Margin="0,10,0,0" FontSize="13" Foreground="{DynamicResource ColorNeutral400}" TextWrapping="Wrap"
                     Text="Next, the files are checked. Then dictation is ready." />
          <!-- Checking: no bar, since nothing can be measured. What is done carries the tick; what is under way breathes. -->
          <StackPanel x:Name="CheckingPanel" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
              <ContentControl Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" Style="{StaticResource SuccessMark}" />
              <TextBlock x:Name="DownloadedText" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
            </StackPanel>
            <TextBlock x:Name="CheckingText" Margin="0,10,0,0" FontSize="13" Foreground="{DynamicResource ColorNeutral400}" Text="Checking the files…"
                       AutomationProperties.LiveSetting="Polite" />
          </StackPanel>
          <TextBlock x:Name="ProgressModelText" Margin="0,16,0,0" FontFamily="{DynamicResource MonoFont}" FontSize="12" Foreground="{DynamicResource ColorNeutral600}" />
        </StackPanel>

        <!-- A stopped state: why, and what to do. -->
        <StackPanel x:Name="StoppedPane" Grid.Row="1" Margin="0,6,0,0">
          <TextBlock x:Name="StatusText" FontSize="13" Foreground="{DynamicResource ColorNeutral400}" TextWrapping="Wrap" />
          <!-- What to do next, in the text colour. -->
          <TextBlock x:Name="NextStepText" Margin="0,10,0,0" FontSize="13" TextWrapping="Wrap" />
          <!-- A stopped engine: where to get what it needs, under the step that names it. -->
          <Button x:Name="VisualCppLink" Margin="0,8,0,0" Style="{StaticResource BodyLink}" Click="GetVisualCppRedistributable"
                  ToolTip="Open Microsoft's download page in your default browser" />
          <!-- The system's own words for a failure: labelled, quieter than the explanation, and selectable so it can be copied. -->
          <StackPanel x:Name="FailureDetailPanel">
            <TextBlock Style="{StaticResource GroupLabel}" Margin="0,20,0,6" Text="DETAILS" />
            <!-- A 16 line box is 20 whole pixels at 125 %, so every wrapped line sits the same distance below the last. -->
            <TextBox x:Name="FailureDetailText" Padding="0" FontFamily="{DynamicResource MonoFont}" FontSize="12" TextBlock.LineHeight="16" TextBlock.LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource ColorNeutral600}" Background="Transparent"
                     BorderThickness="0" IsReadOnly="True" TextWrapping="Wrap" AutomationProperties.Name="Error details">
              <TextBox.Template>
                <ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" Margin="-2,0" /></ControlTemplate>
              </TextBox.Template>
            </TextBox>
          </StackPanel>
        </StackPanel>
      </Grid>
      <!-- The same slim footer as Settings: the secondary action as text, the primary filled at the right. -->
      <Border Grid.Row="2" Grid.Column="1" Padding="16,10,16,12" BorderBrush="{DynamicResource ColorHairline}" BorderThickness="0,1,0,0">
        <Grid>
          <!-- Pulled left by 4 so its text sits on the content's edge, with the footer note; the padding keeps its hit area. -->
          <Button x:Name="BackButton" Margin="-4,0,0,0" HorizontalAlignment="Left" Style="{StaticResource GhostButton}" Height="32" Padding="12,0" Content="Back" Click="Back" />
          <!-- Lifted 2, like the text on a key above its edge, so the note shares a line with Quit PrivateType. -->
          <TextBlock x:Name="FooterNoteText" Margin="8,0,0,2" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource ColorNeutral400}"
                     Text="Quitting stops the download." />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="QuitButton" Style="{StaticResource GhostButton}" Height="32" Padding="12,0" Content="Quit PrivateType" Click="Quit" />
            <Button x:Name="CheckAgainButton" Margin="8,0,0,0" Height="32" Padding="16,0" Click="CheckAgain" />
            <Button x:Name="GetZipButton" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Height="32" Padding="16,0" Click="GetCompleteZip" />
            <Button x:Name="ContinueButton" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Height="32" Padding="16,0" Click="Continue" />
            <Button x:Name="DownloadButton" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Height="32" Padding="16,0" IsEnabled="False" Click="Download" />
            <Button x:Name="DownloadAgainButton" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Height="32" Padding="16,0" Click="DownloadAgain" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
