<Window x:Class="PrivateType.App.ModelSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set up PrivateType" Icon="/PrivateType;component/Assets/PrivateType.ready.ico" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Foreground="{DynamicResource ColorText}" FontFamily="{DynamicResource AppFont}">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="FormStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style TargetType="ProgressBar">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ProgressBar">
              <Border x:Name="PART_Track" Background="{DynamicResource ColorNeutral800}" CornerRadius="2">
                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{DynamicResource ColorAccent}" CornerRadius="2" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <!-- Supporting lines under the heading and the table. -->
      <Style x:Key="FinePrint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource ColorNeutral400}" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>
    </ResourceDictionary>
  </Window.Resources>
  <Border Margin="8" Background="{DynamicResource ColorSurface}" BorderBrush="{DynamicResource ColorDivider}" BorderThickness="1" CornerRadius="12">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="40" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <!-- The same title bar as Settings: keycap mark, name, and what this window is for. -->
      <Border Background="{DynamicResource ColorSurface}" BorderBrush="{DynamicResource ColorHairline}" BorderThickness="0,0,0,1" CornerRadius="11,11,0,0" MouseLeftButtonDown="DragWindow">
        <Grid Margin="16,0,8,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="18" Height="18" CornerRadius="4" Background="{DynamicResource ColorKeycap}" BorderBrush="{DynamicResource ColorKeycapEdge}" BorderThickness="0,0,0,2">
              <Ellipse Width="6" Height="6" Fill="{DynamicResource ColorAccent400}" />
            </Border>
            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Text="PrivateType" />
            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource ColorNeutral400}" Text="local model setup" />
          </StackPanel>
          <Button Width="28" Height="28" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Center" Content="×" FontSize="18" Style="{StaticResource GhostButton}"
                  Click="CloseWindow" AutomationProperties.Name="Close" />
        </Grid>
      </Border>
      <StackPanel Grid.Row="1" Margin="24,18,24,20">
        <TextBlock x:Name="HeadingText" FontSize="15" FontWeight="SemiBold" Text="Download local dictation" />
        <TextBlock x:Name="StatusText" Margin="0,4,0,0" FontSize="13" Foreground="{DynamicResource ColorNeutral400}" TextWrapping="Wrap" Text="Download the local speech model before using dictation." />
        <!-- The system's own words for a failure: quieter than the explanation above, and selectable so it can be copied. -->
        <TextBox x:Name="FailureDetailText" Margin="0,6,0,0" Padding="0" FontSize="12" Foreground="{DynamicResource ColorNeutral400}" Background="Transparent" BorderThickness="0"
                 IsReadOnly="True" TextWrapping="Wrap" AutomationProperties.Name="Error details" Visibility="Collapsed">
          <TextBox.Template>
            <ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" Margin="-2,0" /></ControlTemplate>
          </TextBox.Template>
        </TextBox>
        <!-- What to do next, in the text colour: set only when setup has stopped and needs the person. -->
        <TextBlock x:Name="NextStepText" Margin="0,12,0,0" FontSize="13" TextWrapping="Wrap">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Style.Triggers>
                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <StackPanel x:Name="ConsentPanel">
          <TextBlock Style="{StaticResource GroupLabel}" Margin="0,18,0,6" Text="SPEECH MODEL" />
          <!-- The choices are table rows: the chosen one carries the accent bar, like the current page in the Settings rail. -->
          <Border BorderBrush="{DynamicResource ColorHairline}" BorderThickness="0,0,0,1">
            <ItemsControl x:Name="ModelChoices" KeyboardNavigation.TabNavigation="Continue">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <RadioButton Foreground="{DynamicResource ColorText}" GroupName="SetupModel" IsChecked="{Binding IsChosen, Mode=TwoWay}" Cursor="Hand"
                               FocusVisualStyle="{x:Null}" AutomationProperties.Name="{Binding Name}">
                    <RadioButton.Template>
                      <ControlTemplate TargetType="RadioButton">
                        <Grid>
                          <Border x:Name="Row" Background="Transparent" BorderBrush="{DynamicResource ColorHairline}" BorderThickness="0,1,0,0">
                            <Grid Margin="14,10,12,11">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>
                              <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                              </Grid.RowDefinitions>
                              <Grid Width="16" Height="16" VerticalAlignment="Center">
                                <Ellipse x:Name="Ring" Stroke="{DynamicResource ColorNeutral600}" StrokeThickness="1.5" />
                                <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource ColorAccent}" Visibility="Hidden" />
                              </Grid>
                              <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding ShortName}" />
                                <Border Margin="8,0,0,0" Padding="5,1,5,2" CornerRadius="3" VerticalAlignment="Center" BorderBrush="{DynamicResource ColorNeutral800}" BorderThickness="1"
                                        Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVisibility}}">
                                  <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource ColorNeutral400}" Text="RECOMMENDED" />
                                </Border>
                              </StackPanel>
                              <TextBlock Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12" Typography.NumeralAlignment="Tabular"
                                         Foreground="{DynamicResource ColorNeutral400}" Text="{Binding Size}" />
                              <!-- The model's full ID, as Settings shows it under the same short name. -->
                              <TextBlock Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Margin="0,2,0,0" FontFamily="{DynamicResource MonoFont}" FontSize="11"
                                         Foreground="{DynamicResource ColorNeutral600}" Text="{Binding Name}" />
                              <!-- One description per model: the same three facts for each, so the difference reads across the two cards. -->
                              <StackPanel Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Margin="0,4,0,0">
                                <TextBlock FontSize="13" Foreground="{DynamicResource ColorText}" Text="{Binding Headline}" TextWrapping="Wrap" />
                              </StackPanel>
                            </Grid>
                          </Border>
                          <Border x:Name="Bar" Width="2" HorizontalAlignment="Left" Background="{DynamicResource ColorAccent}" Visibility="Hidden" />
                          <Border x:Name="FocusRing" BorderBrush="{DynamicResource ColorAccent}" BorderThickness="2" CornerRadius="2" Visibility="Hidden" />
                        </Grid>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource ColorHairline}" /></Trigger>
                          <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource ColorNeutral900}" />
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource ColorAccent}" />
                          </Trigger>
                          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Visibility" Value="Visible" /></Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </RadioButton.Template>
                  </RadioButton>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
          <TextBlock Margin="0,10,0,0" Style="{StaticResource FinePrint}" Text="Your voice is processed on this computer." />
          <TextBlock Margin="0,16,0,0" FontSize="13" TextWrapping="Wrap">
            <Hyperlink x:Name="ModelTermsLink" Foreground="{DynamicResource ColorAccent400}" RequestNavigate="OpenModelTerms" ToolTip="Open the model terms in your default browser"><Run x:Name="ModelTermsLinkText" /></Hyperlink>
          </TextBlock>
          <CheckBox x:Name="TermsCheckBox" Margin="0,10,0,0" VerticalContentAlignment="Top" Checked="TermsChanged" Unchecked="TermsChanged"><TextBlock x:Name="TermsText" FontSize="13" TextWrapping="Wrap" /></CheckBox>
          <TextBlock x:Name="StorageNoticeText" Margin="0,10,0,0" Style="{StaticResource FinePrint}" />
        </StackPanel>
        <ProgressBar x:Name="ProgressBar" Margin="0,18,0,0" Height="4" Minimum="0" Maximum="100" Visibility="Collapsed" />
        <!-- Checking a finished download has no measurable progress: the two phases, the first done, the second under way. -->
        <Grid x:Name="PhaseStrip" Margin="0,18,0,0" Visibility="Collapsed" AutomationProperties.Name="Downloaded. Checking files.">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <Border Height="4" CornerRadius="2" Background="{DynamicResource ColorAccent}" />
            <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource ColorNeutral400}" Text="Downloaded ✓" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <Border Height="4" CornerRadius="2" Background="{DynamicResource ColorNeutral800}" />
            <TextBlock Margin="0,8,0,0" FontSize="12" FontWeight="SemiBold" Text="Checking files…" />
          </StackPanel>
        </Grid>
        <!-- Under the choice while choosing; at the end of every other state. -->
        <TextBlock Margin="0,14,0,0" Text="Your voice is processed on this computer.">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource FinePrint}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding Visibility, ElementName=ConsentPanel}" Value="Visible"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </StackPanel>
      <!-- The same slim footer as Settings: the secondary action as text, the primary filled at the right. -->
      <Border Grid.Row="2" Padding="24,10,16,12" BorderBrush="{DynamicResource ColorHairline}" BorderThickness="0,1,0,0">
        <Grid>
        <TextBlock x:Name="DownloadReasonText" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource ColorNeutral400}" Text="Tick the box to download" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="CancelButton" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Height="32" Padding="12,0" Content="Cancel" Click="Cancel" />
          <Button x:Name="RetryButton" Style="{StaticResource PrimaryButton}" Height="32" Padding="16,0" Content="Retry" Visibility="Collapsed" Click="Retry" />
          <Button x:Name="DownloadButton" Style="{StaticResource PrimaryButton}" Height="32" Padding="16,0" Content="Download model" IsEnabled="False" Click="Download" />
        </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
