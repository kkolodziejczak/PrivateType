<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:PrivateType.App">
  <!-- Form controls shared by Settings and its dialogs. Keycaps are the only raised objects; everything else is flat on the page. -->
  <local:KeycapLegendsConverter x:Key="KeycapLegends" />
  <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

  <Style x:Key="SoundVolumeSlider" TargetType="Slider">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Border x:Name="FocusBorder" BorderBrush="Transparent" BorderThickness="2" CornerRadius="5" Padding="2" Height="28" Background="Transparent">
            <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                  <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="3" VerticalAlignment="Center" Background="{DynamicResource ColorNeutral400}" CornerRadius="1.5" /></ControlTemplate></RepeatButton.Template>
                </RepeatButton>
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Width="14" Height="16">
                  <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource ColorText}" BorderBrush="{DynamicResource ColorNeutral600}" BorderThickness="0,0,0,2" CornerRadius="3" /></ControlTemplate></Thumb.Template>
                </Thumb>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                  <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="3" VerticalAlignment="Center" Background="{DynamicResource ColorNeutral800}" CornerRadius="1.5" /></ControlTemplate></RepeatButton.Template>
                </RepeatButton>
              </Track.IncreaseRepeatButton>
            </Track>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FocusBorder" Property="BorderBrush" Value="{DynamicResource ColorAccent}" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
  </Style>

  <!-- Buttons are keys: a raised cap with a darker bottom edge. -->
  <Style TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource ColorText}" />
    <Setter Property="Background" Value="{DynamicResource ColorKeycap}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ColorKeycapEdge}" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="6">
              <ContentPresenter x:Name="Content" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
            </Border>
            <!-- Drawn outside the key, so a focused button keeps its size. -->
            <Border x:Name="FocusRing" Margin="-3" BorderBrush="{DynamicResource ColorAccent}" BorderThickness="2" CornerRadius="9" Visibility="Collapsed" IsHitTestVisible="False" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ColorNeutral800}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.78" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
            </Trigger>
            <!-- One disabled look for every button: a flat neutral key with muted text, never a faded accent. -->
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ColorKeycap}" />
              <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource ColorKeycap}" />
              <Setter TargetName="Content" Property="TextElement.Foreground" Value="{DynamicResource ColorNeutral600}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{DynamicResource ColorAccent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ColorAccent700}" />
    <Setter Property="Foreground" Value="{DynamicResource ColorAccentText}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ColorAccent400}" /></Trigger>
      <!-- The blue ring would double the darker blue edge; while focused the key is one even shape inside an even gap. -->
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource ColorAccent}" /></Trigger>
    </Style.Triggers>
  </Style>
  <!-- A text action: no cap until hovered. -->
  <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource ColorNeutral400}" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="Template">
      <Setter.Value>
        <!-- The key's template without a cap: a disabled text action stays text, in the muted colour. -->
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="Transparent" CornerRadius="6">
              <ContentPresenter x:Name="Content" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
            </Border>
            <Border x:Name="FocusRing" Margin="-3" BorderBrush="{DynamicResource ColorAccent}" BorderThickness="2" CornerRadius="9" Visibility="Collapsed" IsHitTestVisible="False" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ColorNeutral800}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.78" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Content" Property="TextElement.Foreground" Value="{DynamicResource ColorNeutral600}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- A small square icon key, such as play or remove. -->
  <Style x:Key="IconKeyButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource ColorNeutral400}" />
    <Setter Property="ToolTipService.ShowsToolTipOnKeyboardFocus" Value="True" />
  </Style>
  <!-- An empty key drawn with a dashed outline: adds another key to a row. -->
  <Style x:Key="GhostKeyButton" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource ColorNeutral400}" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid Background="Transparent">
            <local:DashedKeyOutline x:Name="Outline" Stroke="{DynamicResource ColorNeutral600}" />
            <Border x:Name="FocusRing" BorderBrush="{DynamicResource ColorAccent}" BorderThickness="2" CornerRadius="6" Visibility="Collapsed" IsHitTestVisible="False" />
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Outline" Property="Stroke" Value="{DynamicResource ColorNeutral400}" />
              <Setter Property="Foreground" Value="{DynamicResource ColorText}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Outline" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
            </Trigger>
            <!-- Nothing to add yet: the outline and its words fade back, like any disabled key. -->
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Outline" Property="Stroke" Value="{DynamicResource ColorNeutral800}" />
              <Setter Property="Foreground" Value="{DynamicResource ColorNeutral600}" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- Plain text links, such as Licenses and Diagnostics in the rail. -->
  <Style x:Key="TextLinkButton" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource ColorNeutral400}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="LinkBorder" Padding="0,3,0,2" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2">
            <ContentPresenter RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource ColorText}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="LinkBorder" Property="BorderBrush" Value="{DynamicResource ColorAccent}" />
              <Setter Property="Foreground" Value="{DynamicResource ColorText}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource ColorText}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <!-- A wrapped label sets VerticalContentAlignment to Top, so the box sits on its first line. -->
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="18" />
              <ColumnDefinition Width="10" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- The fill is one whole shape under the outline, so a ticked box has no seam between its edge and its fill. -->
            <Border x:Name="CheckBoxFill" Grid.Column="0" Width="18" Height="18" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Background="{DynamicResource ColorBg}" CornerRadius="4" />
            <Border x:Name="CheckBoxBorder" Grid.Column="0" Width="18" Height="18" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                    BorderBrush="{DynamicResource ColorNeutral600}" BorderThickness="1.5" CornerRadius="4">
              <Path x:Name="CheckMark" Data="M3.5,8.5 L6.5,11.5 L12.5,4.5" Stroke="{DynamicResource ColorBg}" StrokeThickness="2" StrokeLineJoin="Round" Visibility="Collapsed" />
            </Border>
            <Border x:Name="FocusRing" Grid.Column="0" Width="24" Height="24" Margin="-3" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" BorderBrush="{DynamicResource ColorAccent}"
                    BorderThickness="2" CornerRadius="6" Visibility="Collapsed" IsHitTestVisible="False" />
            <ContentPresenter Grid.Column="2" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="CheckBoxFill" Property="Background" Value="{DynamicResource ColorText}" />
              <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{DynamicResource ColorText}" />
              <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{DynamicResource ColorAccent}" />
              <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- A settings-table row whose value is on or off: the label on the left, the switch at the right edge. -->
  <Style x:Key="SwitchRow" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource ColorText}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
            <!-- The fill is one whole shape under the outline, so a switch that is on has no seam between its edge and its fill. -->
            <Border x:Name="TrackFill" Grid.Column="1" Width="44" Height="24" Margin="12,0,6,0" VerticalAlignment="Center" CornerRadius="12" Background="{DynamicResource ColorBg}" />
            <Border x:Name="Track" Grid.Column="1" Width="44" Height="24" Margin="12,0,6,0" VerticalAlignment="Center" CornerRadius="12"
                    BorderBrush="{DynamicResource ColorNeutral600}" BorderThickness="1.5">
              <Ellipse x:Name="Knob" Width="15" Height="15" Margin="3,0" HorizontalAlignment="Left" Fill="{DynamicResource ColorNeutral400}" />
            </Border>
            <Border x:Name="FocusRing" Grid.Column="1" Width="50" Height="30" Margin="9,0,3,0" VerticalAlignment="Center" CornerRadius="15"
                    BorderBrush="{DynamicResource ColorAccent}" BorderThickness="2" Visibility="Collapsed" IsHitTestVisible="False" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="TrackFill" Property="Background" Value="{DynamicResource ColorText}" />
              <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource ColorText}" />
              <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
              <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource ColorBg}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource ColorAccent}" />
              <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="TextBox">
    <Setter Property="Foreground" Value="{DynamicResource ColorText}" />
    <Setter Property="Background" Value="{DynamicResource ColorBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ColorDivider}" />
    <Setter Property="CaretBrush" Value="{DynamicResource ColorText}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <!-- 1 border + 6 + the text host's own 2 puts the value 9 in, where a dropdown's value starts. -->
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <!-- The text host applies Padding itself, so the frame does not. -->
          <Grid>
            <Border x:Name="TextBoxBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
              <ScrollViewer x:Name="PART_ContentHost" />
            </Border>
            <!-- The ring lies on the field's own edge: one blue border, with no seam inside it and no reach into the rows around it. -->
            <Border x:Name="FocusRing" Margin="-1" BorderBrush="{DynamicResource ColorAccent}" BorderThickness="2" CornerRadius="7" Visibility="Collapsed" IsHitTestVisible="False" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="TextBoxBorder" Property="BorderBrush" Value="{DynamicResource ColorNeutral800}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="TextBoxBorder" Property="BorderBrush" Value="{DynamicResource ColorAccent}" />
              <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A read-only TextBox that records a shortcut, drawn as a row of keycaps. Focus "presses" the keys flat and shows a blinking cursor. -->
  <Style x:Key="KeycapRecorder" TargetType="TextBox">
    <Setter Property="Foreground" Value="{DynamicResource ColorText}" />
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Frame" Background="Transparent" BorderBrush="Transparent" BorderThickness="2" CornerRadius="8" Padding="2.5">
            <StackPanel Orientation="Horizontal">
              <ScrollViewer x:Name="PART_ContentHost" Visibility="Collapsed" />
              <ItemsControl x:Name="Caps" Focusable="False" IsHitTestVisible="False"
                            ItemsSource="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource KeycapLegends}}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border x:Name="Cap" Margin="0,0,5,0" MinWidth="34" Padding="9,5,9,4" CornerRadius="5"
                            Background="{DynamicResource ColorKeycap}" BorderBrush="{DynamicResource ColorKeycapEdge}" BorderThickness="0,0,0,3">
                      <TextBlock x:Name="Legend" HorizontalAlignment="Center" FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource ColorText}" Text="{Binding Legend}" />
                    </Border>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding IsMain}" Value="True">
                        <Setter TargetName="Cap" Property="MinWidth" Value="46" />
                        <Setter TargetName="Legend" Property="Foreground" Value="{DynamicResource ColorAccent400}" />
                        <Setter TargetName="Legend" Property="FontWeight" Value="SemiBold" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsPrompt}" Value="True">
                        <Setter TargetName="Cap" Property="Background" Value="Transparent" />
                        <Setter TargetName="Cap" Property="BorderThickness" Value="0" />
                        <Setter TargetName="Legend" Property="FontFamily" Value="{DynamicResource AppFont}" />
                        <Setter TargetName="Legend" Property="FontSize" Value="13" />
                        <Setter TargetName="Legend" Property="Foreground" Value="{DynamicResource ColorNeutral400}" />
                      </DataTrigger>
                      <!-- Recording: the keys look held down. -->
                      <DataTrigger Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource AncestorType=TextBox}}" Value="True">
                        <Setter TargetName="Cap" Property="BorderThickness" Value="0" />
                        <Setter TargetName="Cap" Property="Margin" Value="0,3,5,0" />
                        <Setter TargetName="Cap" Property="Background" Value="{DynamicResource ColorNeutral900}" />
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock x:Name="Cursor" Margin="2,0,4,0" VerticalAlignment="Center" FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource ColorAccent400}" Text="_" Visibility="Collapsed">
                <TextBlock.Triggers>
                  <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                      <Storyboard RepeatBehavior="Forever">
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" Duration="0:0:1">
                          <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                          <DiscreteDoubleKeyFrame KeyTime="0:0:0.5" Value="0" />
                        </DoubleAnimationUsingKeyFrames>
                      </Storyboard>
                    </BeginStoryboard>
                  </EventTrigger>
                </TextBlock.Triggers>
              </TextBlock>
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Frame" Property="Background" Value="{DynamicResource ColorHairline}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource ColorAccent}" />
              <Setter TargetName="Cursor" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Frame" Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Dropdowns are flat text with a chevron; the field box appears on hover and focus. -->
  <Style x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
    <Setter Property="Foreground" Value="{DynamicResource ColorText}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="ToggleBorder" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource ColorBg}" />
              <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource ColorDivider}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource ColorBg}" />
              <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource ColorAccent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="ToggleBorder" Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- A list with no frame padding of its own, so its rows start and end on the page edge, in line with the dividers around them. -->
  <Style TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
            <ScrollViewer Padding="{TemplateBinding Padding}" Focusable="False"
                          CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                          HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                          VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
              <ItemsPresenter />
            </ScrollViewer>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="Foreground" Value="{DynamicResource ColorText}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <Border Background="{TemplateBinding Background}" CornerRadius="6" />
            <ToggleButton x:Name="ToggleButton" Style="{StaticResource ComboBoxToggleButton}" Focusable="False"
                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
              <Grid>
                <ContentPresenter Margin="8,0,26,0" VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,1,10,0" Stroke="{DynamicResource ColorNeutral400}" StrokeThickness="1.5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M0,0 L4,4 L8,0" />
              </Grid>
            </ToggleButton>
            <!-- On the field's edge, like a text box, so it keeps clear of the row dividers. -->
            <Border x:Name="FocusRing" Margin="-1" BorderBrush="{DynamicResource ColorAccent}" BorderThickness="2" CornerRadius="7" Visibility="Collapsed" IsHitTestVisible="False" />
            <Popup x:Name="Popup" Placement="Bottom" AllowsTransparency="True" IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
              <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,2,0,0" Padding="4" Background="{DynamicResource ColorNeutral900}" BorderBrush="{DynamicResource ColorDivider}" BorderThickness="1" CornerRadius="8">
                <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" CanContentScroll="True">
                  <ItemsPresenter />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource ColorText}" />
    <!-- Tall enough that an open two-option list ends below the value of the row it covers, not through its letters. -->
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ColorKeycap}" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ColorNeutral800}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ProgressBar">
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar"><Border x:Name="PART_Track" Background="{DynamicResource ColorNeutral800}" CornerRadius="3"><Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{DynamicResource ColorAccent}" CornerRadius="3"/></Border></ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- A page in the left rail. The current page has an accent bar on its left edge. -->
  <Style x:Key="PageTab" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource ColorNeutral400}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid x:Name="RailItem" Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="ActiveBar" Background="Transparent" CornerRadius="1" Margin="0,7" />
            <ContentPresenter Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" />
            <Border x:Name="FocusRing" Grid.ColumnSpan="2" Margin="4,1,8,1" BorderBrush="{DynamicResource ColorAccent}" BorderThickness="2" CornerRadius="5" Visibility="Collapsed" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="RailItem" Property="Background" Value="{DynamicResource ColorHairline}" />
              <Setter Property="Foreground" Value="{DynamicResource ColorText}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="ActiveBar" Property="Background" Value="{DynamicResource ColorAccent}" />
              <Setter TargetName="RailItem" Property="Background" Value="{DynamicResource ColorHairline}" />
              <Setter Property="Foreground" Value="{DynamicResource ColorText}" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The dense settings table. -->
  <Style x:Key="GroupLabel" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource ColorNeutral400}" />
    <Setter Property="Margin" Value="0,22,0,4" />
  </Style>
  <Style x:Key="TableRow" TargetType="Border">
    <Setter Property="BorderBrush" Value="{DynamicResource ColorHairline}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="0,4" />
    <Style.Triggers>
      <!-- A focused row is lifted, so a focus ring drawn past its edge stays above the next row's divider. -->
      <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="Panel.ZIndex" Value="1" /></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="RowLabel" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource ColorText}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="RowValue" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    <Setter Property="Foreground" Value="{DynamicResource ColorNeutral400}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- The explanation under a row, shown while the row has keyboard focus. It opens inside its row and moves the rows
       below it down, so it never covers the next row or a group heading; the focused control itself stays put. -->
  <Style x:Key="RowHint" TargetType="Border">
    <Setter Property="Margin" Value="0,2,0,6" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="Background" Value="{DynamicResource ColorNeutral900}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ColorDivider}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Visibility" Value="Collapsed" />
    <Style.Resources>
      <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource ColorNeutral400}" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>
    </Style.Resources>
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
        <Setter Property="Visibility" Value="Visible" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <!-- The warning mark, the one triangle with ! that every window uses: Licenses' missing-texts notice (16), the bubble's state mark (12)
       and the diagnostics severity marks (14). Drawn in a 20-unit box and scaled to the control's size; the ! is cut out, so
       whatever lies behind shows through it. Its colour is the foreground: warning by default, danger for the bubble's failures. -->
  <Style x:Key="WarningMark" TargetType="ContentControl">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Foreground" Value="{DynamicResource ColorWarning}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Viewbox>
            <Canvas Width="20" Height="20">
              <Path Fill="{TemplateBinding Foreground}"
                    Data="F0 M10,2 C10.6,2 11.1,2.3 11.4,2.8 L18.7,15.6 C19.3,16.7 18.5,18 17.3,18 L2.7,18 C1.5,18 0.7,16.7 1.3,15.6 L8.6,2.8 C8.9,2.3 9.4,2 10,2 Z M9,7 L11,7 L10.7,12.5 L9.3,12.5 Z M10,13.6 A1.1,1.1 0 1 1 9.99,13.6 Z" />
            </Canvas>
          </Viewbox>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- The notice strip: a quiet panel that holds a warning mark and its words, as Licenses' missing-texts notice and the
       version choice's forced-close notice draw it. -->
  <Style x:Key="NoticeStrip" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource ColorNeutral900}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,10" />
  </Style>
  <!-- The success mark beside the warning mark: a filled circle with a tick, the tick drawn in the surface colour so it reads
       as cut out. Drawn in the same 20-unit box; its colour is the foreground. -->
  <Style x:Key="SuccessMark" TargetType="ContentControl">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Foreground" Value="{DynamicResource ColorSuccess}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Viewbox>
            <Canvas Width="20" Height="20">
              <Ellipse Canvas.Left="1" Canvas.Top="1" Width="18" Height="18" Fill="{TemplateBinding Foreground}" />
              <Path Stroke="{DynamicResource ColorSurface}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    Data="M6,10.4 L8.8,13.2 L14,7.2" />
            </Canvas>
          </Viewbox>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- The ⓘ after a row label: its tooltip carries the row's explanation for pointer users. -->
  <!-- A 16 px stroked circle-i inside a 24 × 24 target that also takes keyboard focus and then shows the same tip.
       Its stroke and radius are multiples of 0.8, one pixel at 125 %, so the ring and the stem lie on whole pixels there. -->
  <Style x:Key="InfoMark" TargetType="ContentControl">
    <Setter Property="Margin" Value="2,0,0,0" />
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource ColorNeutral400}" />
    <Setter Property="Cursor" Value="Help" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="IsTabStop" Value="True" />
    <Setter Property="AutomationProperties.Name" Value="More information" />
    <Setter Property="AutomationProperties.HelpText" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}" />
    <Setter Property="ToolTipService.InitialShowDelay" Value="150" />
    <Setter Property="ToolTipService.ShowsToolTipOnKeyboardFocus" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Grid Background="Transparent">
            <Path Width="16" Height="16" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Data="M8,0.8 A7.2,7.2 0 1 1 7.99,0.8 Z M8,7.2 V11.6" />
            <Ellipse Width="1.9" Height="1.9" Margin="0,0,0,6.6" Fill="{TemplateBinding Foreground}" />
            <Border x:Name="FocusRing" Margin="-1" BorderBrush="{DynamicResource ColorAccent}" BorderThickness="2" CornerRadius="13" Visibility="Collapsed" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Visibility" Value="Visible" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The settings grid: every label starts at the page edge and every control starts at the end of this column. -->
  <GridLength x:Key="SettingsLabelColumn">200</GridLength>
  <!-- A dropdown in the settings grid: its text starts exactly at the control column. -->
  <!-- Every picker fills one value lane, so all chevrons share one right edge; the lane leaves room for a row's ▶ key.
       While its row has the pointer or focus it rests on the hover fill, so it reads as a control, not as text. -->
  <Style x:Key="ValuePicker" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
    <Setter Property="Height" Value="32" />
    <Setter Property="Width" Value="204" />
    <Setter Property="Margin" Value="-8,0,0,0" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True"><Setter Property="Background" Value="{DynamicResource ColorBg}" /></DataTrigger>
      <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True"><Setter Property="Background" Value="{DynamicResource ColorBg}" /></DataTrigger>
    </Style.Triggers>
  </Style>
  <!-- A switch in the settings grid: the label wraps inside the label column, the switch sits on the control column. -->
  <Style x:Key="GridSwitchRow" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource ColorText}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="{StaticResource SettingsLabelColumn}" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ContentPresenter Margin="0,0,16,0" VerticalAlignment="Center" RecognizesAccessKey="True">
              <ContentPresenter.Resources>
                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                  <Setter Property="TextWrapping" Value="Wrap" />
                </Style>
              </ContentPresenter.Resources>
            </ContentPresenter>
            <!-- The fill is one whole shape under the outline, so a switch that is on has no seam between its edge and its fill. -->
            <Border x:Name="TrackFill" Grid.Column="1" Width="44" Height="24" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="12" Background="{DynamicResource ColorBg}" />
            <Border x:Name="Track" Grid.Column="1" Width="44" Height="24" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="12"
                    BorderBrush="{DynamicResource ColorNeutral600}" BorderThickness="1.5">
              <Ellipse x:Name="Knob" Width="15" Height="15" Margin="3,0" HorizontalAlignment="Left" Fill="{DynamicResource ColorNeutral400}" />
            </Border>
            <Border x:Name="FocusRing" Grid.Column="1" Width="50" Height="30" Margin="-3,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="15"
                    BorderBrush="{DynamicResource ColorAccent}" BorderThickness="2" Visibility="Collapsed" IsHitTestVisible="False" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="TrackFill" Property="Background" Value="{DynamicResource ColorText}" />
              <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource ColorText}" />
              <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
              <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource ColorBg}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource ColorAccent}" />
              <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- An editable entry in a flat list, such as a phrase: text on the page, the field box only on hover and focus. -->
  <Style x:Key="ListField" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Height" Value="30" />
    <!-- 1 border + 8 + the text host's own 2 put the text 11 in; on whole pixels at 125 % that is 13 px, or 10.4,
         so this margin puts the text on the page edge. -->
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="Margin" Value="-10.4,0,0,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ColorBg}" /></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Background" Value="{DynamicResource ColorBg}" /></Trigger>
    </Style.Triggers>
  </Style>
  <!-- Removes a list row: a trash outline in the app's stroke style, so it never reads as the window's close ×.
       Drawn on a grid of 0.8, one pixel at 125 %: the outline is two pixels there and the two inner bars one, with clear gaps. -->
  <DataTemplate x:Key="RemoveGlyph">
    <Grid Width="14.4" Height="14.4">
      <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" StrokeThickness="1.6"
            StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
            Data="M1.6,3.2 H12.8 M5.6,3.2 V1.6 H8.8 V3.2 M3.2,3.2 L4,12.8 H10.4 L11.2,3.2" />
      <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" StrokeThickness="0.8"
            StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M6,6 V10 M8.4,6 V10" />
    </Grid>
  </DataTemplate>
  <!-- The remove key of a list row: 28 × 28, its name on hover and on keyboard focus. The row shows it on hover or focus.
       It has no key edge, so the glyph sits on the button's centre, level with the centre of the field beside it. -->
  <Style x:Key="RowRemoveButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Content" Value="Remove" />
    <Setter Property="ContentTemplate" Value="{StaticResource RemoveGlyph}" />
    <Setter Property="ToolTipService.ShowsToolTipOnKeyboardFocus" Value="True" />
    <Setter Property="Opacity" Value="0" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True"><Setter Property="Opacity" Value="1" /></DataTrigger>
      <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=Border}}" Value="True"><Setter Property="Opacity" Value="1" /></DataTrigger>
    </Style.Triggers>
  </Style>
  <!-- A short status, such as IN USE. The accent marks the one in use. -->
  <Style x:Key="StatusChip" TargetType="Border">
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource ColorDivider}" />
    <Setter Property="TextElement.FontFamily" Value="{DynamicResource AppFont}" />
    <Setter Property="TextElement.FontSize" Value="11" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource ColorNeutral400}" />
  </Style>
  <!-- Secondary text under a row or a group: readable, quieter than labels. -->
  <Style x:Key="PageNote" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource ColorNeutral400}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <!-- A dropdown inside a form: the same bordered field as a text box. -->
  <Style x:Key="FieldToggleButton" TargetType="ToggleButton">
    <Setter Property="Foreground" Value="{DynamicResource ColorText}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="ToggleBorder" Background="{DynamicResource ColorBg}" BorderBrush="{DynamicResource ColorDivider}" BorderThickness="1" CornerRadius="6">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource ColorNeutral800}" /></Trigger>
            <Trigger Property="IsChecked" Value="True"><Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource ColorAccent}" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ToggleBorder" Property="Opacity" Value="0.45" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="FieldComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton Style="{StaticResource FieldToggleButton}" Focusable="False"
                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
              <Grid>
                <ContentPresenter Margin="10,0,26,0" VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,1,10,0" Stroke="{DynamicResource ColorNeutral400}" StrokeThickness="1.5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M0,0 L4,4 L8,0" />
              </Grid>
            </ToggleButton>
            <!-- On the field's edge, like a text box, so it keeps clear of the row dividers. -->
            <Border x:Name="FocusRing" Margin="-1" BorderBrush="{DynamicResource ColorAccent}" BorderThickness="2" CornerRadius="7" Visibility="Collapsed" IsHitTestVisible="False" />
            <Popup Placement="Bottom" AllowsTransparency="True" IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
              <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,2,0,0" Padding="4" Background="{DynamicResource ColorNeutral900}" BorderBrush="{DynamicResource ColorDivider}" BorderThickness="1" CornerRadius="8">
                <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" CanContentScroll="True">
                  <ItemsPresenter />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Visibility" Value="Visible" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
