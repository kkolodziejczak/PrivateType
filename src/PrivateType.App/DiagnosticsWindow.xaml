<Window x:Class="PrivateType.App.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/PrivateType;component/Assets/PrivateType.ready.ico" Width="620" Height="480" WindowStartupLocation="CenterOwner" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" Foreground="{DynamicResource ColorText}" FontFamily="{DynamicResource AppFont}">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="FormStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <!-- The same slim dark scrollbar as Settings. -->
      <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
                <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Margin="3,4" Background="{DynamicResource ColorNeutral800}" CornerRadius="2" /></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
              </Track>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <!-- One entry per table row: mono text between hairlines. -->
      <Style x:Key="EntryRow" TargetType="ListBoxItem">
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource ColorNeutral400}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ListBoxItem">
              <Border x:Name="Row" Padding="0,9" Background="Transparent" BorderBrush="{DynamicResource ColorHairline}" BorderThickness="0,0,0,1">
                <ContentPresenter />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource ColorText}" /></Trigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="Row" Property="Background" Value="{DynamicResource ColorNeutral900}" />
                  <Setter Property="Foreground" Value="{DynamicResource ColorText}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </Window.Resources>
  <Border Margin="8" Background="{DynamicResource ColorSurface}" BorderBrush="{DynamicResource ColorDivider}" BorderThickness="1" CornerRadius="12">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="40" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <!-- The same title bar as Settings: keycap mark, name, and what this window is for. -->
      <Border Background="{DynamicResource ColorSurface}" BorderBrush="{DynamicResource ColorHairline}" BorderThickness="0,0,0,1" CornerRadius="11,11,0,0">
        <Grid Margin="16,0,8,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="18" Height="18" CornerRadius="4" Background="{DynamicResource ColorKeycap}" BorderBrush="{DynamicResource ColorKeycapEdge}" BorderThickness="0,0,0,2">
              <Ellipse Width="6" Height="6" Fill="{DynamicResource ColorAccent400}" />
            </Border>
            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Text="PrivateType" />
            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource ColorNeutral400}" Text="diagnostics" />
          </StackPanel>
          <Button Width="28" Height="28" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Center" Content="×" FontSize="18" Style="{StaticResource GhostButton}"
                  AutomationProperties.Name="Close" Click="Close" />
        </Grid>
      </Border>
      <Grid Grid.Row="1" Margin="24,18,24,16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock FontSize="13" Foreground="{DynamicResource ColorNeutral400}" TextWrapping="Wrap"
                   Text="Warnings, errors, and safe operational breadcrumbs stay in memory only until PrivateType closes. Audio and dictated text are never included." />
        <ListBox x:Name="Entries" Grid.Row="1" Margin="0,14,0,0" DisplayMemberPath="Display" ItemContainerStyle="{StaticResource EntryRow}"
                 BorderBrush="{DynamicResource ColorHairline}" BorderThickness="0,1,0,0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Diagnostics entries" />
      </Grid>
      <!-- The same slim footer as Settings: Clear set apart on the left, Save report filled at the right. -->
      <Border Grid.Row="2" Padding="16,10,16,12" BorderBrush="{DynamicResource ColorHairline}" BorderThickness="0,1,0,0">
        <Grid>
          <Button Style="{StaticResource GhostButton}" Padding="8,6" HorizontalAlignment="Left" Content="Clear" Click="ClearReport" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource GhostButton}" Margin="0,0,6,0" Padding="12,6" Content="Close" Click="Close" />
            <Button Style="{StaticResource GhostButton}" Margin="0,0,6,0" Padding="12,6" Content="Copy report" Click="CopyReport" />
            <Button Style="{StaticResource PrimaryButton}" Padding="16,6" Content="Save report" Click="SaveReport" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
