<Window x:Class="PrivateType.App.ExportPhrasesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export phrases" Icon="/PrivateType;component/Assets/PrivateType.ready.ico" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" ShowInTaskbar="False"
        Background="Transparent" Foreground="{DynamicResource ColorText}" FontFamily="{DynamicResource AppFont}">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="FormStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Border Margin="8" Background="{DynamicResource ColorSurface}" BorderBrush="{DynamicResource ColorDivider}" BorderThickness="1" CornerRadius="12">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="40" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Border BorderBrush="{DynamicResource ColorHairline}" BorderThickness="0,0,0,1" CornerRadius="11,11,0,0" Background="Transparent" MouseLeftButtonDown="DragWindow">
        <Grid Margin="16,0,8,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,36,0">
            <Border Width="18" Height="18" CornerRadius="4" Background="{DynamicResource ColorKeycap}" BorderBrush="{DynamicResource ColorKeycapEdge}" BorderThickness="0,0,0,2">
              <Ellipse Width="6" Height="6" Fill="{DynamicResource ColorAccent400}" />
            </Border>
            <TextBlock x:Name="TitleText" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="Export phrases" />
          </StackPanel>
          <Button Style="{StaticResource GhostButton}" Width="28" Height="28" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Center" Content="×" FontSize="18"
                  IsCancel="True" AutomationProperties.Name="Close" />
        </Grid>
      </Border>

      <StackPanel Grid.Row="1" Margin="24,14,24,16">
        <TextBlock Foreground="{DynamicResource ColorNeutral400}" FontSize="12" TextWrapping="Wrap"
                   Text="Untick anything you do not want to share. Only the ticked phrases are written." />
        <TextBlock Style="{StaticResource GroupLabel}" Margin="0,18,0,4" Text="PHRASES" />
        <!-- A flat table: one hairline row per phrase, the phrase in mono beside its tick. -->
        <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
          <ItemsControl x:Name="PhraseList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{DynamicResource ColorHairline}" BorderThickness="0,1,0,0" MinHeight="36">
                  <CheckBox VerticalAlignment="Center" FontFamily="{DynamicResource MonoFont}" FontSize="13" IsChecked="{Binding IsSelected, Mode=TwoWay}" Content="{Binding Phrase}"
                            Checked="SelectionChanged" Unchecked="SelectionChanged" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <Border BorderBrush="{DynamicResource ColorHairline}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
          <TextBlock x:Name="SummaryText" Foreground="{DynamicResource ColorNeutral400}" FontSize="12" TextWrapping="Wrap" />
        </Border>
      </StackPanel>

      <!-- Slim footer: a message on the left, the text-button Cancel, then the filled primary action at the right. -->
      <Border Grid.Row="2" Padding="24,10,16,12" BorderBrush="{DynamicResource ColorHairline}" BorderThickness="0,1,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="ErrorText" Margin="0,0,16,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource ColorDanger}" TextWrapping="Wrap"
                     AutomationProperties.LiveSetting="Polite" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Style="{StaticResource GhostButton}" Margin="0,0,6,0" Padding="12,6" Content="Cancel" IsCancel="True" />
            <Button x:Name="SaveAsButton" Style="{StaticResource PrimaryButton}" Padding="16,6" Content="Save as…" IsDefault="True" Click="SaveAs" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
