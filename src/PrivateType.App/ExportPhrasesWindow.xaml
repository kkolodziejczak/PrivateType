<Window x:Class="PrivateType.App.ExportPhrasesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export phrases" Icon="/PrivateType;component/Assets/PrivateType.ready.ico" Width="520" Height="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" ShowInTaskbar="False"
        Background="Transparent" Foreground="{DynamicResource ColorText}" FontFamily="{DynamicResource AppFont}">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="FormStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Border Margin="8" Background="{DynamicResource ColorSurface}" BorderBrush="{DynamicResource ColorDivider}" BorderThickness="1" CornerRadius="16">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="42" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Border Background="{DynamicResource ColorNeutral900}" CornerRadius="15,15,0,0" MouseLeftButtonDown="DragWindow">
        <Grid Margin="16,0,8,0">
          <TextBlock x:Name="TitleText" VerticalAlignment="Center" Foreground="{DynamicResource ColorText}" Opacity="0.8" FontSize="13" Text="Export phrases" />
          <Button Width="28" Height="28" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Center" Content="×" FontSize="18"
                  Background="Transparent" BorderBrush="Transparent" Foreground="{DynamicResource ColorNeutral400}" IsCancel="True" AutomationProperties.Name="Close" />
        </Grid>
      </Border>
      <Grid Grid.Row="1" Margin="22">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Margin="0,0,0,10" Foreground="{DynamicResource ColorText}" Opacity="0.7" FontSize="13" TextWrapping="Wrap"
                   Text="Untick anything you do not want to share. Only the ticked phrases are written." />
        <Border Grid.Row="1" Background="{DynamicResource ColorBg}" BorderBrush="{DynamicResource ColorDivider}" BorderThickness="1" CornerRadius="8">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="10,8" Focusable="False">
            <ItemsControl x:Name="PhraseList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <CheckBox Margin="0,4" IsChecked="{Binding IsSelected, Mode=TwoWay}" Content="{Binding Phrase}" Checked="SelectionChanged" Unchecked="SelectionChanged" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
          <TextBlock x:Name="SummaryText" Foreground="{DynamicResource ColorText}" Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
          <TextBlock x:Name="ErrorText" Margin="0,6,0,0" Foreground="{DynamicResource ColorAccent300}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
          <StackPanel Margin="0,12,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Margin="0,0,8,0" Content="Cancel" IsCancel="True" />
            <Button x:Name="SaveAsButton" Style="{StaticResource PrimaryButton}" Content="Save as…" IsDefault="True" Click="SaveAs" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
