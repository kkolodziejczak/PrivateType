<Window x:Class="PrivateType.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PrivateType settings" Icon="/PrivateType;component/Assets/PrivateType.ready.ico" Width="620" Height="800"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Foreground="{DynamicResource ColorText}" FontFamily="{DynamicResource AppFont}"
        PreviewKeyDown="SwitchPageWithKeyboard">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="FormStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Border Margin="8" Background="{DynamicResource ColorSurface}" BorderBrush="{DynamicResource ColorDivider}" BorderThickness="1" CornerRadius="16">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="42" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Border Grid.Row="0" Background="{DynamicResource ColorNeutral900}" CornerRadius="15,15,0,0" MouseLeftButtonDown="DragWindow">
        <Grid Margin="16,0,8,0">
          <TextBlock x:Name="SettingsHeaderText" VerticalAlignment="Center" Foreground="{DynamicResource ColorText}" Opacity="0.8" FontSize="13" TextTrimming="CharacterEllipsis" />
          <Button Width="28" Height="28" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Center" Content="×" FontSize="18"
                  Background="Transparent" BorderBrush="Transparent" Foreground="{DynamicResource ColorNeutral400}" Click="CloseWindow" />
        </Grid>
      </Border>
      <Border Grid.Row="1" Padding="22" Background="{DynamicResource ColorSurface}" CornerRadius="0,0,14,14">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock FontSize="22" FontWeight="SemiBold" Text="Settings" />
            <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource ColorText}" Opacity="0.7" FontSize="14" TextWrapping="Wrap" Text="Choose your input, shortcuts, vocabulary, and ready sound." />
            <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
              <RadioButton x:Name="GeneralTab" Style="{StaticResource PageTab}" GroupName="SettingsPage" Content="General" IsChecked="True" Checked="PageChanged" AutomationProperties.Name="General settings" />
              <RadioButton x:Name="VocabularyTab" Style="{StaticResource PageTab}" GroupName="SettingsPage" Margin="8,0,0,0" Content="Vocabulary" Checked="PageChanged" AutomationProperties.Name="Vocabulary settings" />
            </StackPanel>
          </StackPanel>
          <ScrollViewer x:Name="SettingsScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,16" Padding="0,0,12,0" Focusable="False">
            <ScrollViewer.Resources>
              <Style TargetType="ScrollBar">
                <Setter Property="Width" Value="12" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                      <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                        <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
                        <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Margin="3,0" Background="{DynamicResource ColorNeutral400}" CornerRadius="3" /></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                        <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
                      </Track>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ScrollViewer.Resources>
        <Grid>
        <Grid x:Name="GeneralPage">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="0" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="22" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="22" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="22" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="22" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>


          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="140" />
              <ColumnDefinition Width="16" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
              <TextBlock FontWeight="SemiBold" FontSize="14" Text="Microphone" />
              <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="{DynamicResource ColorText}" Opacity="0.55" Text="Used for every shortcut" />
            </StackPanel>
            <ComboBox x:Name="MicrophoneBox" Grid.Column="2" Height="36" Padding="8,0" AutomationProperties.Name="Microphone" SelectedValuePath="Id">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Foreground="{DynamicResource ColorText}" Text="{Binding DisplayName}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>

          <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="140" />
              <ColumnDefinition Width="16" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Top">
              <TextBlock FontWeight="SemiBold" FontSize="14" Text="Shortcuts" />
              <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="{DynamicResource ColorText}" Opacity="0.55" Text="Start dictation and insert text" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <ItemsControl x:Name="BindingsList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Margin="0,0,0,8" Padding="8" Background="{DynamicResource ColorBg}" BorderBrush="{DynamicResource ColorDivider}" BorderThickness="1" CornerRadius="8">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="128" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" Height="31" Padding="7,0" ItemsSource="{Binding SupportedLanguages}" SelectedValuePath="LocaleCode"
                                  SelectedValue="{Binding LocaleCode, Mode=TwoWay}" IsTextSearchEnabled="True" TextSearch.TextPath="Label"
                                  AutomationProperties.Name="Recognition language" MaxDropDownHeight="320">
                          <ComboBox.ItemTemplate>
                            <DataTemplate>
                              <TextBlock Foreground="{DynamicResource ColorText}" Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBox Grid.Column="1" Margin="8,0" Height="31" Padding="9,0" IsReadOnly="True" Text="{Binding ShortcutLabel, Mode=OneWay}" PreviewKeyDown="RecordShortcut"
                                 ToolTip="Click, then press Ctrl+Shift plus a key." />
                        <Button Grid.Column="2" Content="—" Tag="{Binding}" Click="RemoveBinding" FontSize="12" Width="31" Height="31" Padding="0"
                                ToolTip="Remove shortcut" AutomationProperties.Name="Remove shortcut" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Style="{StaticResource GhostButton}" Width="136" HorizontalAlignment="Left" Content="+ Add shortcut" Click="AddBinding" />
              <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource ColorText}" Opacity="0.55" FontSize="12" TextWrapping="Wrap"
                         Text="Choose a recognition language or Automatic. Then click a shortcut and press Ctrl+Shift plus a letter, number, or function key." />
              <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="8" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource ColorText}" Opacity="0.8" Text="Shortcut behavior" />
                <ComboBox x:Name="ShortcutModeBox" Grid.Column="1" Height="36" Padding="8,0" SelectedValuePath="Id" AutomationProperties.Name="Shortcut behavior">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Foreground="{DynamicResource ColorText}" Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Grid.Row="2" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource ColorText}" Opacity="0.8" Text="Insert text by" />
                <ComboBox x:Name="InsertionModeBox" Grid.Row="2" Grid.Column="1" Height="36" Padding="8,0" SelectedValuePath="Id" AutomationProperties.Name="Insert text by"
                          SelectionChanged="InsertionModeChanged">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Foreground="{DynamicResource ColorText}" Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </Grid>
              <TextBlock x:Name="InsertionModeHint" Margin="0,8,0,0" Foreground="{DynamicResource ColorText}" Opacity="0.55" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>

          <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="140" />
              <ColumnDefinition Width="16" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Top">
              <TextBlock FontWeight="SemiBold" FontSize="14" Text="Startup &amp; resources" />
              <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="{DynamicResource ColorText}" Opacity="0.55" Text="Launch quietly, free model memory when idle" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <CheckBox x:Name="StartWithWindowsCheckBox" Content="Start PrivateType with Windows" AutomationProperties.Name="Start PrivateType with Windows" />
              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="180" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource ColorText}" Opacity="0.8" Text="Unload model after" />
                <ComboBox x:Name="IdleTimeoutBox" Grid.Column="1" Height="36" Padding="8,0" SelectedValuePath="Minutes" AutomationProperties.Name="Unload model after">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Foreground="{DynamicResource ColorText}" Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </Grid>
            </StackPanel>
          </Grid>

          <Grid Grid.Row="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="140" />
              <ColumnDefinition Width="16" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock FontWeight="SemiBold" FontSize="14" Text="Ready sound" />
              <TextBlock Margin="0,3,0,0" FontSize="12" Opacity="0.7" TextWrapping="Wrap" Text="Hear when you can speak after model loading" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="ReadySoundBox" Height="36" SelectedValuePath="Id" AutomationProperties.Name="Ready sound" SelectionChanged="ReadySoundChanged">
                  <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" Foreground="{DynamicResource ColorText}" /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <Button x:Name="PreviewSoundButton" Grid.Column="1" Margin="8,0,0,0" Content="▶ Preview" AutomationProperties.Name="Preview ready sound" Click="PreviewSound" />
              </Grid>
              <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Volume" VerticalAlignment="Center" />
                <Slider x:Name="ReadyVolumeSlider" Style="{StaticResource SoundVolumeSlider}" Grid.Column="1" Margin="10,0" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="5" LargeChange="10" ValueChanged="ReadyVolumeChanged" VerticalAlignment="Center" AutomationProperties.Name="Ready sound volume" />
                <TextBlock x:Name="ReadyVolumeText" Grid.Column="2" Text="80%" TextAlignment="Right" VerticalAlignment="Center" />
              </Grid>
              <TextBlock Margin="0,4,0,0" FontSize="12" Opacity="0.7" Text="0% mutes the ready sound." />
              <TextBlock Margin="0,14,0,6" Text="Custom file" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="CustomSoundPathText" Height="36" Padding="8,0" IsReadOnly="True" FontWeight="Normal" AutomationProperties.Name="Custom ready sound file" />
                <Button x:Name="BrowseSoundButton" Grid.Column="1" Margin="8,0,0,0" Content="Browse…" AutomationProperties.Name="Choose custom ready sound file" Click="BrowseSound" />
              </Grid>
              <TextBlock Margin="0,6,0,0" FontSize="12" Opacity="0.7" TextWrapping="Wrap" Text="WAV or MP3, up to 3 seconds of playback. Copied into app storage when saved." />
              <TextBlock x:Name="SoundStatusText" Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource ColorAccent300}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
          </Grid>

          <StackPanel Grid.Row="10">
            <Border Padding="12" Background="{DynamicResource ColorBg}" BorderBrush="{DynamicResource ColorDivider}" BorderThickness="1" CornerRadius="8">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                  <Border Width="44" Height="44" VerticalAlignment="Center" Background="{DynamicResource ColorAccent900}" CornerRadius="8">
                    <Viewbox Width="28" Height="28" Margin="8">
                      <Grid Width="32" Height="32">
                        <Rectangle Width="2.5" Height="8" RadiusX="1.25" RadiusY="1.25" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="9.6,12,0,0" Fill="{DynamicResource ColorAccent300}" />
                        <Rectangle Width="2.5" Height="13" RadiusX="1.25" RadiusY="1.25" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14.6,9.5,0,0" Fill="{DynamicResource ColorAccent300}" />
                        <Rectangle Width="2.5" Height="8" RadiusX="1.25" RadiusY="1.25" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="19.6,12,0,0" Fill="{DynamicResource ColorAccent300}" />
                      </Grid>
                    </Viewbox>
                  </Border>
                  <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock FontWeight="SemiBold" FontSize="14" Text="Local speech model" />
                    <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource ColorText}" Opacity="0.55" FontSize="12" Text="Nemotron 3.5 ASR Streaming 0.6B (Q8_0)" />
                  </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Padding="10,5" VerticalAlignment="Center" Background="{DynamicResource ColorAccent800}" CornerRadius="8">
                  <TextBlock Foreground="{DynamicResource ColorAccent100}" FontSize="12" FontWeight="SemiBold" Text="Installed" />
                </Border>
              </Grid>
            </Border>
          </StackPanel>
        </Grid>
        <StackPanel x:Name="VocabularyPage" Visibility="Collapsed">
          <TextBlock FontWeight="SemiBold" FontSize="16" Text="Vocabulary" />
          <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource ColorText}" Opacity="0.7" FontSize="13" TextWrapping="Wrap"
                     Text="Help the local model recognize names, acronyms, and specialist terms. Type each word or phrase exactly as it should be written." />
          <Grid Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="10" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource ColorText}" Opacity="0.8" Text="Language" />
            <ComboBox x:Name="VocabularyScopeBox" Grid.Column="1" Height="36" Padding="8,0" ItemsSource="{Binding Scopes}" SelectedValuePath="Code"
                      SelectedValue="{Binding Scope, Mode=TwoWay}" IsTextSearchEnabled="True" TextSearch.TextPath="DisplayName" MaxDropDownHeight="320"
                      AutomationProperties.Name="Vocabulary language">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Foreground="{DynamicResource ColorText}" Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Grid.Row="2" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource ColorText}" Opacity="0.8" Text="Strength" />
            <ComboBox x:Name="VocabularyStrengthBox" Grid.Row="2" Grid.Column="1" Height="36" Padding="8,0" ItemsSource="{Binding Strengths}" SelectedValuePath="Id"
                      SelectedValue="{Binding Strength, Mode=TwoWay}" AutomationProperties.Name="Vocabulary strength">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Foreground="{DynamicResource ColorText}" Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>
          <TextBlock Margin="0,10,0,0" Foreground="{DynamicResource ColorText}" Opacity="0.55" FontSize="12" TextWrapping="Wrap" Text="{Binding ScopeHint}" />
          <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource ColorText}" Opacity="0.55" FontSize="12" TextWrapping="Wrap"
                     Text="Strength applies to every phrase. Stronger settings help rare words more but can also insert them where they were not said." />
          <Grid Margin="0,22,0,0">
            <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Opacity="0.7" Text="YOUR PHRASES" />
            <Button x:Name="ExportPhrasesButton" HorizontalAlignment="Right" FontSize="12" Padding="10,5" Content="Export…" Click="ExportPersonalPhrases"
                    IsEnabled="{Binding HasVisiblePhrases}" AutomationProperties.Name="Export your phrases" />
          </Grid>
          <Border x:Name="VocabularyEmptyState" Margin="0,10,0,0" Padding="12" Background="{DynamicResource ColorBg}" BorderBrush="{DynamicResource ColorDivider}" BorderThickness="1" CornerRadius="8"
                  Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Foreground="{DynamicResource ColorText}" Opacity="0.8" FontSize="13" TextWrapping="Wrap" Text="{Binding EmptyText}" />
          </Border>
          <ItemsControl x:Name="VocabularyList" Margin="0,10,0,0" ItemsSource="{Binding Visible}" KeyboardNavigation.TabNavigation="Continue">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBox Height="31" Padding="9,0" MaxLength="120" Text="{Binding Phrase, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Vocabulary phrase" />
                  <Button Grid.Column="1" Margin="8,0,0,0" Content="—" Tag="{Binding}" Click="RemoveVocabularyPhrase" FontSize="12" Width="31" Height="31" Padding="0"
                          ToolTip="Remove phrase" AutomationProperties.Name="Remove phrase" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button x:Name="AddPhraseButton" Style="{StaticResource GhostButton}" Margin="0,4,0,0" Width="136" HorizontalAlignment="Left" Content="+ Add phrase" Click="AddVocabularyPhrase" />
          <Grid Margin="0,22,0,0">
            <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Opacity="0.7" Text="PACKS" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
              <CheckBox x:Name="ShowAllPacksBox" Margin="0,0,12,0" VerticalAlignment="Center" Content="Show all packs" IsChecked="{Binding ShowAllPacks, Mode=TwoWay}"
                        AutomationProperties.Name="Show packs for every language" />
              <Button x:Name="ImportPackButton" FontSize="12" Padding="10,5" Content="Import pack…" Click="ImportPack" AutomationProperties.Name="Import vocabulary pack" />
            </StackPanel>
          </Grid>
          <Border x:Name="PacksEmptyState" Margin="0,10,0,0" Padding="12" Background="{DynamicResource ColorBg}" BorderBrush="{DynamicResource ColorDivider}" BorderThickness="1" CornerRadius="8"
                  Visibility="{Binding HasNoVisiblePacks, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Foreground="{DynamicResource ColorText}" Opacity="0.8" FontSize="13" TextWrapping="Wrap" Text="{Binding PacksEmptyText}" />
          </Border>
          <ItemsControl x:Name="PackList" Margin="0,10,0,0" ItemsSource="{Binding VisiblePacks}" KeyboardNavigation.TabNavigation="Continue">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Margin="0,0,0,8" Padding="12,10" Background="{DynamicResource ColorBg}" BorderBrush="{DynamicResource ColorDivider}" BorderThickness="1" CornerRadius="8">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                      <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}" AutomationProperties.Name="{Binding ToggleName}">
                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                      </CheckBox>
                      <TextBlock Margin="28,4,0,0" FontSize="12" Opacity="0.6" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                      <Button Margin="0,0,6,0" FontSize="12" Padding="10,5" Content="Edit" Tag="{Binding}" Click="EditPack" AutomationProperties.Name="Edit pack" />
                      <Button Margin="0,0,6,0" FontSize="12" Padding="10,5" Content="Export…" Tag="{Binding}" Click="ExportPack" AutomationProperties.Name="Export pack" />
                      <Button FontSize="12" Padding="10,5" Content="Remove…" Tag="{Binding}" Click="RemovePack" AutomationProperties.Name="Remove pack" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock x:Name="VocabularyBudgetText" Margin="0,14,0,0" Foreground="{DynamicResource ColorText}" Opacity="0.55" FontSize="12" TextWrapping="Wrap" Text="{Binding BudgetText}" />
          <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource ColorText}" Opacity="0.55" FontSize="12" TextWrapping="Wrap"
                     Text="Phrases stay on this computer unless you export them, and are only given to the local speech engine." />
        </StackPanel>
        </Grid>
          </ScrollViewer>
          <StackPanel Grid.Row="2">
            <TextBlock x:Name="ValidationText" TextWrapping="Wrap" Foreground="{DynamicResource ColorAccent300}" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal">
                <Button Margin="0,0,8,0" Content="Licenses…" AutomationProperties.Name="Open-source licenses" Click="OpenLicenses" />
                <Button Content="Diagnostics…" AutomationProperties.Name="View diagnostics" Click="OpenDiagnostics" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="CancelSettingsButton" Margin="0,0,8,0" Content="Cancel" IsCancel="True" />
                <Button x:Name="SaveSettingsButton" Style="{StaticResource PrimaryButton}" Content="Save changes" IsDefault="True" Click="Save" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
