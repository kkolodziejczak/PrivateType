<Window x:Class="PrivateType.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PrivateType settings" Icon="/PrivateType;component/Assets/PrivateType.ready.ico" Width="660" Height="800"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" WindowStyle="None" UseLayoutRounding="True" AllowsTransparency="True"
        Background="Transparent" Foreground="{DynamicResource ColorText}" FontFamily="{DynamicResource AppFont}"
        PreviewKeyDown="SwitchPageWithKeyboard">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="FormStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Border Margin="8" Background="{DynamicResource ColorSurface}" BorderBrush="{DynamicResource ColorDivider}" BorderThickness="1" CornerRadius="12">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="40" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <!-- Title bar: a small keycap mark, the name and the version. -->
      <Border Grid.Row="0" Background="{DynamicResource ColorSurface}" BorderBrush="{DynamicResource ColorHairline}" BorderThickness="0,0,0,1" CornerRadius="11,11,0,0" MouseLeftButtonDown="DragWindow">
        <Grid Margin="16,0,8,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="18" Height="18" CornerRadius="4" Background="{DynamicResource ColorKeycap}" BorderBrush="{DynamicResource ColorKeycapEdge}" BorderThickness="0,0,0,2">
              <Ellipse Width="6" Height="6" Fill="{DynamicResource ColorAccent400}" />
            </Border>
            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Text="PrivateType" />
            <TextBlock x:Name="SettingsHeaderText" Margin="8,1,0,0" VerticalAlignment="Center" FontFamily="{DynamicResource MonoFont}" FontSize="12"
                       Foreground="{DynamicResource ColorNeutral600}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <Button Width="28" Height="28" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Center" Content="×" FontSize="18" Style="{StaticResource GhostButton}"
                  Click="CloseWindow" AutomationProperties.Name="Close" />
        </Grid>
      </Border>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="150" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!-- The footer has its own cell, outside the page: a page wider than its column by a rounding pixel can never move it. -->
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- Left rail: pages at the top, the rarely used windows pinned at the bottom. -->
        <Border Grid.Column="0" Grid.RowSpan="2" Background="{DynamicResource ColorBg}" BorderBrush="{DynamicResource ColorHairline}" BorderThickness="0,0,1,0" CornerRadius="0,0,0,11">
          <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="16,0,16,16">
              <Button Content="Licenses…" Style="{StaticResource TextLinkButton}" AutomationProperties.Name="Open-source licenses" Click="OpenLicenses" />
              <Button Margin="0,4,0,0" Content="Diagnostics…" Style="{StaticResource TextLinkButton}" AutomationProperties.Name="View diagnostics" Click="OpenDiagnostics" />
              <TextBlock Margin="0,12,0,0" FontSize="12" Foreground="{DynamicResource ColorNeutral600}" Text="runs on this PC" />
            </StackPanel>
            <StackPanel Margin="0,14,0,0">
              <RadioButton x:Name="GeneralTab" Style="{StaticResource PageTab}" GroupName="SettingsPage" Content="General" IsChecked="True" Checked="PageChanged" AutomationProperties.Name="General settings" />
              <RadioButton x:Name="VocabularyTab" Style="{StaticResource PageTab}" GroupName="SettingsPage" Margin="0,2,0,0" Content="Vocabulary" Checked="PageChanged" AutomationProperties.Name="Vocabulary settings" />
              <RadioButton x:Name="ModelTab" Style="{StaticResource PageTab}" GroupName="SettingsPage" Margin="0,2,0,0" Content="Model" Checked="PageChanged" AutomationProperties.Name="Speech model settings" />
            </StackPanel>
          </DockPanel>
        </Border>
        <Grid Grid.Column="1">
          <ScrollViewer x:Name="SettingsScrollViewer" Grid.Row="0" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" Focusable="False" ScrollChanged="ShowScrollFade">
            <ScrollViewer.Resources>
              <Style TargetType="ScrollBar">
                <Setter Property="Width" Value="10" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                      <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                        <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
                        <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Margin="3,4" Background="{DynamicResource ColorNeutral800}" CornerRadius="2" /></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                        <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
                      </Track>
                      <!-- The lane is kept on every page so the content edge never moves; a page that fits shows no thumb. -->
                      <ControlTemplate.Triggers>
                        <Trigger Property="Maximum" Value="0"><Setter TargetName="PART_Track" Property="Visibility" Value="Hidden" /></Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ScrollViewer.Resources>
        <!-- The bottom padding equals the scroll fade, so at the end of the page the last row is clear of it. -->
        <Grid Margin="24,18,16,16">
        <!-- Every page is one grid: labels start at the page edge, controls start at the end of SettingsLabelColumn. -->
        <StackPanel x:Name="GeneralPage">
          <!-- The heart of the page: each shortcut drawn as the keys you hold, then the language it dictates in. -->
          <TextBlock Style="{StaticResource GroupLabel}" Margin="0,0,0,6" Text="DICTATE WITH" />
          <ItemsControl x:Name="BindingsList" KeyboardNavigation.TabNavigation="Continue">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid x:Name="ShortcutRow" MinHeight="54" Background="Transparent">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource SettingsLabelColumn}" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBox x:Name="KeyBox" Grid.Column="0" Style="{StaticResource KeycapRecorder}" Margin="-4,1.6,0,-1.6" Text="{Binding ShortcutLabel, Mode=OneWay}" PreviewKeyDown="RecordShortcut"
                           ToolTip="Click, then press Ctrl+Shift plus a key." AutomationProperties.Name="{Binding ShortcutLabel, StringFormat='Shortcut {0}'}" />
                  <TextBlock x:Name="Arrow" Grid.Column="0" Margin="0,0,10,0" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="16" Foreground="{DynamicResource ColorNeutral600}" Text="→" />
                  <ComboBox x:Name="LanguageBox" Grid.Column="1" Style="{StaticResource ValuePicker}" ItemsSource="{Binding SupportedLanguages}" SelectedValuePath="LocaleCode"
                            SelectedValue="{Binding LocaleCode, Mode=TwoWay}" IsTextSearchEnabled="True" TextSearch.TextPath="Label"
                            AutomationProperties.Name="Recognition language" MaxDropDownHeight="320">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Foreground="{DynamicResource ColorText}" Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock x:Name="RecordHint" Grid.Column="1" Grid.ColumnSpan="2" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource ColorNeutral400}"
                             Text="Press Ctrl+Shift + a key" Visibility="Collapsed" />
                  <Button x:Name="RemoveButton" Grid.Column="2" Style="{StaticResource GhostButton}" Width="28" Height="28" Padding="0" BorderThickness="0" ContentTemplate="{StaticResource RemoveGlyph}" Content="Remove" Opacity="0"
                          ToolTipService.ShowsToolTipOnKeyboardFocus="True"
                          Tag="{Binding}" Click="RemoveBinding"
                          ToolTip="{Binding ShortcutLabel, StringFormat='Remove {0} shortcut'}" AutomationProperties.Name="{Binding ShortcutLabel, StringFormat='Remove {0} shortcut'}" />
                </Grid>
                <DataTemplate.Triggers>
                  <Trigger SourceName="ShortcutRow" Property="IsMouseOver" Value="True">
                    <Setter TargetName="RemoveButton" Property="Opacity" Value="1" />
                  </Trigger>
                  <Trigger SourceName="ShortcutRow" Property="IsKeyboardFocusWithin" Value="True">
                    <Setter TargetName="RemoveButton" Property="Opacity" Value="1" />
                  </Trigger>
                  <Trigger SourceName="KeyBox" Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="RecordHint" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Arrow" Property="Visibility" Value="Hidden" />
                    <Setter TargetName="LanguageBox" Property="Visibility" Value="Hidden" />
                  </Trigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Style="{StaticResource GhostKeyButton}" Margin="0,6,0,0" HorizontalAlignment="Left" Content="+ Add shortcut" Click="AddBinding" />
          <TextBlock Style="{StaticResource PageNote}" Margin="0,12,0,0" Text="Click the keys, then press Ctrl+Shift plus a letter, number, or function key." />

          <!-- Everything else: one quiet row per setting. -->
          <TextBlock Style="{StaticResource GroupLabel}" Margin="0,30,0,4" Text="INPUT" />
          <Border Style="{StaticResource TableRow}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{StaticResource SettingsLabelColumn}" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource RowLabel}" Text="Microphone" />
              <ComboBox x:Name="MicrophoneBox" Grid.Column="1" Style="{StaticResource ValuePicker}" AutomationProperties.Name="Microphone" SelectedValuePath="Id">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Foreground="{DynamicResource ColorText}" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>
          </Border>
          <Border Style="{StaticResource TableRow}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{StaticResource SettingsLabelColumn}" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource RowLabel}" Text="Shortcut behavior" />
              <ComboBox x:Name="ShortcutModeBox" Grid.Column="1" Style="{StaticResource ValuePicker}" SelectedValuePath="Id" AutomationProperties.Name="Shortcut behavior">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Foreground="{DynamicResource ColorText}" Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>
          </Border>
          <Border Style="{StaticResource TableRow}">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="{StaticResource SettingsLabelColumn}" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource RowLabel}" Text="Insert text by" />
                  <ContentControl Style="{StaticResource InfoMark}" ToolTip="{Binding Text, ElementName=InsertionModeHint}" />
                </StackPanel>
                <ComboBox x:Name="InsertionModeBox" Grid.Column="1" Style="{StaticResource ValuePicker}" SelectedValuePath="Id" AutomationProperties.Name="Insert text by"
                          SelectionChanged="InsertionModeChanged">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Foreground="{DynamicResource ColorText}" Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </Grid>
              <Border Style="{StaticResource RowHint}"><TextBlock x:Name="InsertionModeHint" /></Border>
            </StackPanel>
          </Border>

          <TextBlock Style="{StaticResource GroupLabel}" Text="RECENT DICTATIONS" />
          <Border Style="{StaticResource TableRow}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{StaticResource SettingsLabelColumn}" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource RowLabel}" Text="Keep dictations" />
              <ComboBox x:Name="HistoryRetentionBox" Grid.Column="1" Style="{StaticResource ValuePicker}" SelectedValuePath="Id" AutomationProperties.Name="Keep recent dictations"
                        SelectionChanged="HistoryOptionChanged">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Foreground="{DynamicResource ColorText}" Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>
          </Border>
          <Border Style="{StaticResource TableRow}">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="{StaticResource SettingsLabelColumn}" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="HistoryShortcutLabel" Style="{StaticResource RowLabel}" Text="Picker shortcut" />
                  <ContentControl Style="{StaticResource InfoMark}" ToolTip="{Binding Text, ElementName=HistoryHint}" />
                </StackPanel>
                <TextBox x:Name="HistoryShortcutBox" Grid.Column="1" Style="{StaticResource KeycapRecorder}" Margin="-4,1.6,0,-1.6"
                         ToolTip="Click, then press the new shortcut, for example Win+Shift+V." AutomationProperties.Name="Recent dictations shortcut"
                         GotKeyboardFocus="StartRecordingHistoryShortcut" LostKeyboardFocus="StopRecordingHistoryShortcut" />
              </Grid>
              <Border Style="{StaticResource RowHint}"><TextBlock x:Name="HistoryHint" /></Border>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource TableRow}">
            <StackPanel>
              <CheckBox x:Name="ClipboardHistoryCheckBox" Style="{StaticResource GridSwitchRow}"
                        Content="Show in clipboard history"
                        AutomationProperties.Name="Show pasted dictations in Windows clipboard history" Checked="HistoryOptionChanged" Unchecked="HistoryOptionChanged" />
              <!-- Always shown: it says what other apps can read, and the switch it explains cannot take focus while typing. -->
              <TextBlock x:Name="ClipboardHistoryHint" Style="{StaticResource PageNote}" Margin="0,0,0,6" />
            </StackPanel>
          </Border>

          <TextBlock Style="{StaticResource GroupLabel}" Text="STARTUP" />
          <Border Style="{StaticResource TableRow}">
            <StackPanel>
              <CheckBox x:Name="StartWithWindowsCheckBox" Style="{StaticResource GridSwitchRow}" Content="Start PrivateType with Windows" AutomationProperties.Name="Start PrivateType with Windows" />
              <TextBlock x:Name="StartWithWindowsHint" Style="{StaticResource PageNote}" Margin="0,0,0,8" Visibility="Collapsed"
                         Text="Only a copy from the portable ZIP can change this. This one was built from source." />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource TableRow}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{StaticResource SettingsLabelColumn}" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource RowLabel}" Text="Unload model after" />
              <ComboBox x:Name="IdleTimeoutBox" Grid.Column="1" Style="{StaticResource ValuePicker}" SelectedValuePath="Minutes" AutomationProperties.Name="Unload model after">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Foreground="{DynamicResource ColorText}" Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>
          </Border>

          <TextBlock Style="{StaticResource GroupLabel}" Text="SOUND" />
          <Border Style="{StaticResource TableRow}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{StaticResource SettingsLabelColumn}" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource RowLabel}" Text="Ready sound" ToolTip="Plays when the microphone is listening and you can speak." />
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ComboBox x:Name="ReadySoundBox" Style="{StaticResource ValuePicker}" SelectedValuePath="Id" AutomationProperties.Name="Ready sound" SelectionChanged="ReadySoundChanged">
                  <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" Foreground="{DynamicResource ColorText}" /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <Button x:Name="PreviewSoundButton" Margin="8,0,0,0" Style="{StaticResource IconKeyButton}" Content="▶" ToolTip="Preview" AutomationProperties.Name="Preview ready sound" Click="PreviewSound" />
              </StackPanel>
            </Grid>
          </Border>
          <Border Style="{StaticResource TableRow}">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="{StaticResource SettingsLabelColumn}" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource RowLabel}" Text="Volume" />
                  <ContentControl Style="{StaticResource InfoMark}" ToolTip="0% mutes the ready sound and spoken cues." />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <Slider x:Name="ReadyVolumeSlider" Style="{StaticResource SoundVolumeSlider}" Width="140" Margin="-4,0,0,0" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="5" LargeChange="10" ValueChanged="ReadyVolumeChanged" VerticalAlignment="Center" AutomationProperties.Name="Ready sound volume" />
                  <TextBlock x:Name="ReadyVolumeText" Margin="12,0,0,0" Style="{StaticResource RowValue}" Text="80%" />
                </StackPanel>
              </Grid>
              <Border Style="{StaticResource RowHint}"><TextBlock Text="0% mutes the ready sound and spoken cues." /></Border>
            </StackPanel>
          </Border>
          <!-- Only a custom ready sound needs a file. -->
          <Border>
            <Border.Style>
              <Style TargetType="Border" BasedOn="{StaticResource TableRow}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding SelectedValue, ElementName=ReadySoundBox}" Value="custom">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="{StaticResource SettingsLabelColumn}" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource RowLabel}" Text="Custom file" />
                  <ContentControl Style="{StaticResource InfoMark}" ToolTip="WAV or MP3, up to 3 seconds of playback. Copied into app storage when saved." />
                </StackPanel>
                <TextBox x:Name="CustomSoundPathText" Grid.Column="1" Height="30" IsReadOnly="True" FontFamily="{DynamicResource MonoFont}" FontSize="12" AutomationProperties.Name="Custom ready sound file" />
                <Button x:Name="BrowseSoundButton" Grid.Column="2" Margin="8,0,0,0" Content="Browse…" AutomationProperties.Name="Choose custom ready sound file" Click="BrowseSound" />
              </Grid>
              <Border Style="{StaticResource RowHint}"><TextBlock Text="WAV or MP3, up to 3 seconds of playback. Copied into app storage when saved." /></Border>
            </StackPanel>
          </Border>
          <TextBlock x:Name="SoundStatusText" Margin="0,2,0,6" FontSize="12" Foreground="{DynamicResource ColorWarning}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Style.Triggers>
                  <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <Border Style="{StaticResource TableRow}">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="{StaticResource SettingsLabelColumn}" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource RowLabel}" Text="Spoken cues" />
                  <ContentControl Style="{StaticResource InfoMark}" ToolTip="Says “Loading model” while the model loads and “Transcribing” while Parakeet finishes your text. Uses the volume above." />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <ComboBox x:Name="SpokenCueVoiceBox" Style="{StaticResource ValuePicker}" SelectedValuePath="Id" AutomationProperties.Name="Spoken cues" SelectionChanged="SpokenCueVoiceChanged">
                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" Foreground="{DynamicResource ColorText}" /></DataTemplate></ComboBox.ItemTemplate>
                  </ComboBox>
                  <Button x:Name="PreviewSpokenCueButton" Margin="8,0,0,0" Style="{StaticResource IconKeyButton}" Content="▶" ToolTip="Preview" AutomationProperties.Name="Preview spoken cue" Click="PreviewSpokenCue" />
                </StackPanel>
              </Grid>
              <Border Style="{StaticResource RowHint}"><TextBlock Text="Says &#x201C;Loading model&#x201D; while the model loads and &#x201C;Transcribing&#x201D; while Parakeet finishes your text. Uses the volume above." /></Border>
            </StackPanel>
          </Border>

          <TextBlock Style="{StaticResource GroupLabel}" Text="OTHER COPIES" />
          <Border Style="{StaticResource TableRow}">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="{StaticResource SettingsLabelColumn}" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource RowLabel}" Text="Settings from another copy" />
                  <ContentControl Style="{StaticResource InfoMark}" ToolTip="Choose the folder of another PrivateType copy. You'll see what will be copied before anything changes." />
                </StackPanel>
                <Button x:Name="ImportFromCopyButton" Grid.Column="1" HorizontalAlignment="Left" Content="Import…" Click="ImportFromCopy"
                        AutomationProperties.Name="Import settings from another copy" />
              </Grid>
              <Border Style="{StaticResource RowHint}"><TextBlock Text="Choose the folder of another PrivateType copy. You'll see what will be copied before anything changes." /></Border>
            </StackPanel>
          </Border>
          <!-- The table closes with a hairline, so the end of the page reads as an end. -->
          <Border Style="{StaticResource TableRow}" MinHeight="0" Padding="0" />
        </StackPanel>
        <StackPanel x:Name="VocabularyPage" Visibility="Collapsed">
          <!-- Shown only when the chosen model cannot boost phrases while it listens. -->
          <Border Margin="0,0,0,18" Padding="12,8,8,8" CornerRadius="6" Background="{DynamicResource ColorNeutral900}"
                  Visibility="{Binding DataContext.HasBoostNotice, ElementName=ModelPage, Converter={StaticResource BoolToVisibility}}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="BoostNoticeText" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource ColorText}" TextWrapping="Wrap" Text="{Binding DataContext.BoostNotice, ElementName=ModelPage}" />
              <Button Grid.Column="1" Margin="12,0,4,0" VerticalAlignment="Center" Style="{StaticResource TextLinkButton}" Content="Change model" Click="OpenModelPage" AutomationProperties.Name="Change speech model" />
            </Grid>
          </Border>
          <Grid Margin="0,0,0,4">
            <TextBlock Style="{StaticResource GroupLabel}" Margin="0" VerticalAlignment="Center" Text="YOUR PHRASES" />
            <Button x:Name="ExportPhrasesButton" HorizontalAlignment="Right" Style="{StaticResource GhostButton}" FontSize="12" Padding="8,4" Content="Export…" Click="ExportPersonalPhrases"
                    IsEnabled="{Binding HasVisiblePhrases}" AutomationProperties.Name="Export your phrases" />
          </Grid>
          <Border Style="{StaticResource TableRow}">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="{StaticResource SettingsLabelColumn}" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource RowLabel}" Text="Language" />
                <ComboBox x:Name="VocabularyScopeBox" Grid.Column="1" Style="{StaticResource ValuePicker}" ItemsSource="{Binding Scopes}" SelectedValuePath="Code"
                          SelectedValue="{Binding Scope, Mode=TwoWay}" IsTextSearchEnabled="True" TextSearch.TextPath="DisplayName" MaxDropDownHeight="320"
                          AutomationProperties.Name="Vocabulary language">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Foreground="{DynamicResource ColorText}" Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </Grid>
              <TextBlock Style="{StaticResource PageNote}" Margin="0,0,0,6" Text="{Binding ScopeHint}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource TableRow}">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="{StaticResource SettingsLabelColumn}" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource RowLabel}" Text="Strength" />
                  <ContentControl Style="{StaticResource InfoMark}" ToolTip="{Binding Text, ElementName=StrengthHint}" />
                </StackPanel>
                <ComboBox x:Name="VocabularyStrengthBox" Grid.Column="1" Style="{StaticResource ValuePicker}" ItemsSource="{Binding Strengths}" SelectedValuePath="Id"
                          SelectedValue="{Binding Strength, Mode=TwoWay}" AutomationProperties.Name="Vocabulary strength">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Foreground="{DynamicResource ColorText}" Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </Grid>
              <Border Style="{StaticResource RowHint}"><TextBlock x:Name="StrengthHint" Text="Strength applies to every phrase. Stronger settings help rare words more but can also insert them where they were not said." /></Border>
            </StackPanel>
          </Border>
          <!-- The phrases: a flat mono list; each row shows its field and × on hover. -->
          <Border x:Name="VocabularyEmptyState" Style="{StaticResource TableRow}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Style="{StaticResource PageNote}" Margin="0,6" Text="{Binding EmptyText}" />
          </Border>
          <ItemsControl x:Name="VocabularyList" ItemsSource="{Binding Visible}" KeyboardNavigation.TabNavigation="Continue">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource TableRow}" MinHeight="36" Padding="0,3" Background="Transparent">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Style="{StaticResource ListField}" MaxLength="120" Text="{Binding Phrase, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Vocabulary phrase" />
                    <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource RowRemoveButton}" Tag="{Binding}" Click="RemoveVocabularyPhrase"
                            ToolTip="Remove phrase" AutomationProperties.Name="Remove phrase" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button x:Name="AddPhraseButton" Style="{StaticResource GhostKeyButton}" Margin="0,8,0,0" HorizontalAlignment="Left" Content="+ Add phrase" Click="AddVocabularyPhrase" />

          <TextBlock Style="{StaticResource GroupLabel}" Text="AFTER DICTATION" />
          <Border Style="{StaticResource TableRow}">
            <StackPanel>
              <CheckBox x:Name="CorrectAfterDictationBox" Style="{StaticResource GridSwitchRow}" Content="Fix phrases after dictation" IsChecked="{Binding CorrectAfterDictation, Mode=TwoWay}"
                        AutomationProperties.Name="Fix phrases after dictation" />
              <TextBlock Style="{StaticResource PageNote}" Margin="0,0,0,8"
                         Text="When you release the shortcut, spoken forms of your phrases, such as “three D printing” for 3D printing, and the wordings below are rewritten before the text is inserted. This works in every language; numbers and letters are recognized in English and Polish." />
            </StackPanel>
          </Border>
          <Grid Margin="0,8,0,0" Visibility="{Binding HasVisibleCorrections, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="28" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="36" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource GroupLabel}" Margin="0,0,0,4" Text="HEARD" />
            <TextBlock Grid.Column="2" Style="{StaticResource GroupLabel}" Margin="0,0,0,4" Text="WRITE" />
          </Grid>
          <Border x:Name="CorrectionsEmptyState" Style="{StaticResource TableRow}" Visibility="{Binding HasNoVisibleCorrections, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Style="{StaticResource PageNote}" Margin="0,6" Text="{Binding CorrectionsEmptyText}" />
          </Border>
          <ItemsControl x:Name="CorrectionList" ItemsSource="{Binding VisibleCorrections}" KeyboardNavigation.TabNavigation="Continue">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource TableRow}" MinHeight="36" Padding="0,3" Background="Transparent">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="28" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Style="{StaticResource ListField}" MaxLength="120" Text="{Binding Heard, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Heard as" />
                    <TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource ColorNeutral600}" Text="→" />
                    <TextBox Grid.Column="2" Style="{StaticResource ListField}" MaxLength="120" Text="{Binding Phrase, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Write as" />
                    <Button Grid.Column="3" Margin="8,0,0,0" Style="{StaticResource RowRemoveButton}" Tag="{Binding}" Click="RemoveCorrection"
                            ToolTip="Remove correction" AutomationProperties.Name="Remove correction" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button x:Name="AddCorrectionButton" Style="{StaticResource GhostKeyButton}" Margin="0,8,0,0" HorizontalAlignment="Left" Content="+ Add correction" Click="AddCorrection" />

          <Grid Margin="0,22,0,4">
            <TextBlock Style="{StaticResource GroupLabel}" Margin="0" VerticalAlignment="Center" Text="PACKS" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
              <CheckBox x:Name="ShowAllPacksBox" Margin="0,0,12,0" VerticalAlignment="Center" FontSize="12" Content="Show all packs" IsChecked="{Binding ShowAllPacks, Mode=TwoWay}"
                        AutomationProperties.Name="Show packs for every language" />
              <Button x:Name="ImportPackButton" FontSize="12" Padding="10,4" Content="Import pack…" Click="ImportPack" AutomationProperties.Name="Import vocabulary pack" />
            </StackPanel>
          </Grid>
          <Border x:Name="PacksEmptyState" Style="{StaticResource TableRow}" Visibility="{Binding HasNoVisiblePacks, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Style="{StaticResource PageNote}" Margin="0,6" Text="{Binding PacksEmptyText}" />
          </Border>
          <ItemsControl x:Name="PackList" ItemsSource="{Binding VisiblePacks}" KeyboardNavigation.TabNavigation="Continue">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource TableRow}" Padding="0,8">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                      <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}" AutomationProperties.Name="{Binding ToggleName}">
                        <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                      </CheckBox>
                      <TextBlock Style="{StaticResource PageNote}" Margin="28,2,0,0" Text="{Binding Summary}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                      <Button Style="{StaticResource GhostButton}" FontSize="12" Padding="8,4" Content="Edit" Tag="{Binding}" Click="EditPack" AutomationProperties.Name="Edit pack" />
                      <Button Style="{StaticResource GhostButton}" FontSize="12" Padding="8,4" Content="Export…" Tag="{Binding}" Click="ExportPack" AutomationProperties.Name="Export pack" />
                      <Button Style="{StaticResource GhostButton}" FontSize="12" Padding="8,4" Content="Remove…" Tag="{Binding}" Click="RemovePack" AutomationProperties.Name="Remove pack" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border Style="{StaticResource TableRow}" MinHeight="0" Padding="0" />
          <TextBlock x:Name="VocabularyBudgetText" Style="{StaticResource PageNote}" Margin="0,14,0,0" Text="{Binding BudgetText}" />
          <TextBlock Style="{StaticResource PageNote}" Margin="0,4,0,0"
                     Text="Phrases stay on this computer unless you export them, and are only given to the local speech engine." />
        </StackPanel>
        <StackPanel x:Name="ModelPage" Visibility="Collapsed">
          <TextBlock Style="{StaticResource GroupLabel}" Margin="0,0,0,4" Text="SPEECH MODEL" />
          <TextBlock Style="{StaticResource PageNote}" Margin="0,0,0,10"
                     Text="Download the models you want to try, choose which one PrivateType uses, and delete the ones you no longer need. Downloading a model accepts its terms." />
          <!-- One table row per model: short name, size and status first; the technical name and terms as a dim mono line. -->
          <ItemsControl x:Name="ModelList" ItemsSource="{Binding Rows}" KeyboardNavigation.TabNavigation="Continue">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource TableRow}" Padding="0,10">
                  <Grid>
                    <Rectangle Width="2" Margin="-12,2,0,2" HorizontalAlignment="Left" RadiusX="1" RadiusY="1" Fill="{DynamicResource ColorAccent}"
                               Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}" />
                    <StackPanel>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Text="{Binding ShortName}" />
                        <TextBlock Grid.Column="1" Margin="10,1,0,0" Style="{StaticResource RowValue}" Text="{Binding SizeText}" />
                        <StackPanel Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                          <Border>
                            <Border.Style>
                              <Style TargetType="Border" BasedOn="{StaticResource StatusChip}">
                                <Style.Triggers>
                                  <!-- Beside a key the chip is centred on the key's face, which sits 2 above the key's bottom edge. -->
                                  <DataTrigger Binding="{Binding CanDownload}" Value="True"><Setter Property="Margin" Value="0,0,0,2" /></DataTrigger>
                                  <DataTrigger Binding="{Binding CanUse}" Value="True"><Setter Property="Margin" Value="0,0,0,2" /></DataTrigger>
                                  <DataTrigger Binding="{Binding IsDownloading}" Value="True"><Setter Property="Margin" Value="0,0,0,2" /></DataTrigger>
                                  <DataTrigger Binding="{Binding CanDelete}" Value="True"><Setter Property="Margin" Value="0,0,0,2" /></DataTrigger>
                                  <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource ColorAccent700}" />
                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource ColorAccent400}" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding StatusChip}" ToolTip="{Binding StatusText}"
                                       AutomationProperties.Name="{Binding StatusText}" AutomationProperties.LiveSetting="Polite" />
                          </Border>
                          <Button Margin="8,0,0,0" FontSize="12" Padding="10,4" Content="Download" Tag="{Binding}" Click="DownloadModel"
                                  Visibility="{Binding CanDownload, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="{Binding DownloadName}" />
                          <Button Margin="8,0,0,0" FontSize="12" Padding="8,4" Style="{StaticResource GhostButton}" Content="Cancel" Tag="{Binding}" Click="CancelModelDownload"
                                  Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="{Binding CancelName}" />
                          <Button Margin="8,0,0,0" FontSize="12" Padding="10,4" Content="Use" Tag="{Binding}" Click="UseModel"
                                  Visibility="{Binding CanUse, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="{Binding UseName}" />
                          <Button Margin="4,0,0,0" FontSize="12" Padding="8,4" Style="{StaticResource GhostButton}" Content="Delete…" Tag="{Binding}" Click="DeleteModel"
                                  Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="{Binding DeleteName}" />
                        </StackPanel>
                      </Grid>
                      <TextBlock Margin="0,4,0,0" FontFamily="{DynamicResource MonoFont}" FontSize="11" Foreground="{DynamicResource ColorNeutral600}" TextWrapping="Wrap">
                        <Run Text="{Binding TechnicalLine, Mode=OneWay}" /><Run Text=" · " /><Hyperlink NavigateUri="{Binding LicenseUri}" RequestNavigate="OpenModelTerms" Foreground="{DynamicResource ColorNeutral400}">terms</Hyperlink>
                      </TextBlock>
                      <ProgressBar Margin="0,8,0,0" Height="4" Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}"
                                   Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}" />
                      <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource ColorText}" TextWrapping="Wrap" Text="{Binding DownloadNextStep, Mode=OneWay}"
                                 Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}" />
                      <TextBlock Style="{StaticResource PageNote}" Margin="0,6,0,0" Text="{Binding Summary}" />
                      <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource ColorWarning}" TextWrapping="Wrap" Text="{Binding Error}"
                                 Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border Style="{StaticResource TableRow}">
            <StackPanel>
              <CheckBox x:Name="OfflinePreviewCheckBox" Style="{StaticResource GridSwitchRow}" Content="Live preview with Parakeet" AutomationProperties.Name="Show a live preview with Parakeet" />
              <TextBlock Style="{StaticResource PageNote}" Margin="0,0,0,8"
                         Text="Re-transcribes about once a second while you hold the shortcut, so you can spot mistakes early. Uses more CPU while you speak; the inserted text still comes from one pass on release." />
            </StackPanel>
          </Border>

          <TextBlock Style="{StaticResource GroupLabel}" Text="PROCESSING" />
          <Border Style="{StaticResource TableRow}">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="{StaticResource SettingsLabelColumn}" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource RowLabel}" Text="Run model on" />
                <ComboBox x:Name="ModelDeviceBox" Grid.Column="1" Style="{StaticResource ValuePicker}" SelectedValuePath="Id" AutomationProperties.Name="Run model on">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Foreground="{DynamicResource ColorText}" Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </Grid>
              <StackPanel x:Name="ModelDeviceStatusPanel" Margin="0,4,0,4" Orientation="Horizontal">
                <Ellipse x:Name="ModelDeviceStatusDot" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{DynamicResource ColorNeutral400}" />
                <TextBlock x:Name="ModelDeviceStatusText" FontSize="13" Foreground="{DynamicResource ColorText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
              </StackPanel>
              <TextBlock Style="{StaticResource PageNote}" Margin="0,2,0,8"
                         Text="Automatic uses a graphics card when one is available — much faster, but uses more battery. Choose Processor only to save battery. Changes apply the next time the model loads." />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource TableRow}" MinHeight="0" Padding="0" />
          <TextBlock Style="{StaticResource PageNote}" Margin="0,14,0,0" Text="{Binding StorageText}" />
          <TextBlock Style="{StaticResource PageNote}" Margin="0,4,0,0"
                     Text="Models run on this computer. Your voice is processed locally." />
        </StackPanel>
        </Grid>
          </ScrollViewer>
          <!-- Page scrolled: it fades out under the title bar, so a row divider passing under the header line never reads as a second line. -->
          <Rectangle x:Name="ScrollFadeTop" Grid.Row="0" Height="16" Margin="0,0,12,0" VerticalAlignment="Top" IsHitTestVisible="False" Visibility="Hidden">
            <Rectangle.Fill>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#FF1B1C20" />
                <GradientStop Offset="1" Color="#001B1C20" />
              </LinearGradientBrush>
            </Rectangle.Fill>
          </Rectangle>
          <!-- More page below: it fades into the footer. At the end the fade goes, so the page visibly stops. -->
          <Rectangle x:Name="ScrollFade" Grid.Row="0" Height="16" Margin="0,0,12,0" VerticalAlignment="Bottom" IsHitTestVisible="False">
            <Rectangle.Fill>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#001B1C20" />
                <GradientStop Offset="1" Color="#FF1B1C20" />
              </LinearGradientBrush>
            </Rectangle.Fill>
          </Rectangle>
        </Grid>
        <Border Grid.Row="1" Grid.Column="1" Padding="24,10,16,12" BorderBrush="{DynamicResource ColorHairline}" BorderThickness="0,1,0,0" CornerRadius="0,0,11,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ValidationText" Margin="0,0,16,0" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource ColorText}" AutomationProperties.LiveSetting="Polite" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="CancelSettingsButton" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Height="32" Padding="12,0" Content="Cancel" IsCancel="True" />
              <Button x:Name="SaveSettingsButton" Style="{StaticResource PrimaryButton}" Height="32" Padding="16,0" Content="Save changes" IsDefault="True" Click="Save" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
