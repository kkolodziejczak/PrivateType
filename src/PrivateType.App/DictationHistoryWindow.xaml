<Window x:Class="PrivateType.App.DictationHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PrivateType recent dictations" Icon="/PrivateType;component/Assets/PrivateType.ready.ico" Width="460" SizeToContent="Height" MaxHeight="560"
        WindowStartupLocation="Manual" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" ShowInTaskbar="False" Topmost="True"
        Background="Transparent" Foreground="{DynamicResource ColorText}" FontFamily="{DynamicResource AppFont}" PreviewKeyDown="HandleKeys">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="FormStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <!-- The same slim dark scrollbar as Settings. -->
      <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="12" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
                <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Margin="3,0" Background="{DynamicResource ColorNeutral400}" CornerRadius="3" /></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
              </Track>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <!-- A small keycap that names a key in the footer hints. -->
      <Style x:Key="HintKey" TargetType="Border">
        <Setter Property="MinWidth" Value="24" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Padding" Value="5,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Background" Value="{DynamicResource ColorKeycap}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ColorKeycapEdge}" />
        <Setter Property="BorderThickness" Value="0,0,0,2" />
      </Style>
      <Style x:Key="HintKeyLegend" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource ColorText}" />
      </Style>
      <Style x:Key="HintAction" TargetType="TextBlock">
        <Setter Property="Margin" Value="6,0,14,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource ColorNeutral400}" />
      </Style>
    </ResourceDictionary>
  </Window.Resources>
  <Border Margin="8" Background="{DynamicResource ColorSurface}" BorderBrush="{DynamicResource ColorDivider}" BorderThickness="1" CornerRadius="12">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="40" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <!-- Title bar: the keycap mark and the name; Clear all and close share one centre line. -->
      <Border BorderBrush="{DynamicResource ColorHairline}" BorderThickness="0,0,0,1" CornerRadius="11,11,0,0">
        <Grid Margin="16,0,8,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="18" Height="18" CornerRadius="4" Background="{DynamicResource ColorKeycap}" BorderBrush="{DynamicResource ColorKeycapEdge}" BorderThickness="0,0,0,2">
              <Ellipse Width="6" Height="6" Fill="{DynamicResource ColorAccent400}" />
            </Border>
            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Text="Recent dictations" />
          </StackPanel>
          <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
            <Button x:Name="ClearAllButton" Style="{StaticResource GhostButton}" Height="28" Padding="10,0" VerticalAlignment="Center" FontSize="12" Content="Clear all" Click="ClearAll"
                    AutomationProperties.Name="Clear all recent dictations" />
            <Button Style="{StaticResource GhostButton}" Width="28" Height="28" Margin="4,0,0,0" Padding="0" VerticalAlignment="Center" Content="×" FontSize="18"
                    Click="CloseWindow" AutomationProperties.Name="Close" />
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1" Margin="0,4,0,0">
        <TextBlock x:Name="EmptyText" Margin="24,22,24,26" Foreground="{DynamicResource ColorNeutral400}" FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                   Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
        <!-- A flat mono list: hairlines between rows, a tinted selected row, the focus ring only for keyboard focus, the remove key on hover and on the selected row.
             Each hairline sits above its row and the first row has none, so the last row ends on the footer's own line. -->
        <ListBox x:Name="EntriesList" HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                 AutomationProperties.Name="Recent dictations" KeyboardNavigation.TabNavigation="Once">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="0" />
              <Setter Property="Cursor" Value="Hand" />
              <Setter Property="FocusVisualStyle" Value="{x:Null}" />
              <Setter Property="BorderThickness" Value="0,1,0,0" />
              <Setter Property="AutomationProperties.Name" Value="{Binding Preview}" />
              <Setter Property="AutomationProperties.HelpText" Value="{Binding Details}" />
              <EventSetter Event="MouseLeftButtonUp" Handler="ChooseClickedEntry" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Grid Background="Transparent">
                      <Border x:Name="Tint" Margin="6,2" CornerRadius="6" />
                      <Border Margin="16,0,10,0" Padding="0,10" BorderBrush="{DynamicResource ColorHairline}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter />
                      </Border>
                      <Border x:Name="FocusRing" Margin="6,2" BorderBrush="{DynamicResource ColorAccent}" BorderThickness="2" CornerRadius="6"
                              Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Tint" Property="Background" Value="{DynamicResource ColorHairline}" />
                      </Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="Tint" Property="Background" Value="{DynamicResource ColorHairline}" />
                      </Trigger>
                      <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
              <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                  <Setter Property="BorderThickness" Value="0" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Foreground="{DynamicResource ColorText}" FontFamily="{DynamicResource MonoFont}" FontSize="13" Text="{Binding Preview}" TextWrapping="Wrap"
                             TextTrimming="CharacterEllipsis" MaxHeight="57" LineHeight="19" LineStackingStrategy="BlockLineHeight" />
                  <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource ColorNeutral400}" FontFamily="{DynamicResource MonoFont}" FontSize="11" Text="{Binding Details}" />
                    <Border Margin="10,0,0,0" Padding="5,1" VerticalAlignment="Center" CornerRadius="3" BorderBrush="{DynamicResource ColorWarning}" BorderThickness="1"
                            Visibility="{Binding ShowNotInserted, Converter={StaticResource BoolToVisibility}}">
                      <TextBlock Foreground="{DynamicResource ColorWarning}" FontFamily="{DynamicResource MonoFont}" FontSize="10" FontWeight="SemiBold" Text="NOT INSERTED" />
                    </Border>
                    <!-- The way back: the row's own Enter key pastes it. -->
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource ColorNeutral400}" FontSize="12" Text="select it and press Enter to paste"
                               Visibility="{Binding ShowNotInserted, Converter={StaticResource BoolToVisibility}}" />
                  </StackPanel>
                </StackPanel>
                <Button x:Name="RemoveKey" Grid.Column="1" Style="{StaticResource IconKeyButton}" Margin="10,0,0,0" VerticalAlignment="Top" ContentTemplate="{StaticResource RemoveGlyph}" Content="Remove"
                        Focusable="False" Opacity="0" Tag="{Binding}" Click="RemoveEntry" ToolTip="Remove dictation" AutomationProperties.Name="Remove dictation" />
              </Grid>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                  <Setter TargetName="RemoveKey" Property="Opacity" Value="1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                  <Setter TargetName="RemoveKey" Property="Opacity" Value="1" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>

      <!-- Footer: the keys that act on the selected row, then where the list is kept. -->
      <Border x:Name="KeyHintText" Grid.Row="2" Padding="16,9,16,11" BorderBrush="{DynamicResource ColorHairline}" BorderThickness="0,1,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal">
            <Border Style="{StaticResource HintKey}"><TextBlock Style="{StaticResource HintKeyLegend}" Text="Enter" /></Border>
            <TextBlock Style="{StaticResource HintAction}" Text="paste" />
            <Border Style="{StaticResource HintKey}"><TextBlock Style="{StaticResource HintKeyLegend}" Text="Del" /></Border>
            <TextBlock Style="{StaticResource HintAction}" Text="remove" />
            <Border Style="{StaticResource HintKey}"><TextBlock Style="{StaticResource HintKeyLegend}" Text="Esc" /></Border>
            <TextBlock Style="{StaticResource HintAction}" Text="close" />
          </StackPanel>
          <TextBlock Grid.Column="1" VerticalAlignment="Center" FontFamily="{DynamicResource MonoFont}" FontSize="11" Foreground="{DynamicResource ColorNeutral600}"
                     Text="kept in memory only" />
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
