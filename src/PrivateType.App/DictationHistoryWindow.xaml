<Window x:Class="PrivateType.App.DictationHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PrivateType recent dictations" Icon="/PrivateType;component/Assets/PrivateType.ready.ico" Width="460" SizeToContent="Height" MaxHeight="560"
        WindowStartupLocation="Manual" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" ShowInTaskbar="False" Topmost="True"
        Background="Transparent" Foreground="{DynamicResource ColorText}" FontFamily="{DynamicResource AppFont}" PreviewKeyDown="HandleKeys">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="FormStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <!-- The same slim dark scrollbar as Settings. -->
      <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="12" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
                <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Margin="3,0" Background="{DynamicResource ColorNeutral400}" CornerRadius="3" /></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
              </Track>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </Window.Resources>
  <Border Margin="8" Background="{DynamicResource ColorSurface}" BorderBrush="{DynamicResource ColorDivider}" BorderThickness="1" CornerRadius="16">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="42" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Border Background="{DynamicResource ColorNeutral900}" CornerRadius="15,15,0,0">
        <Grid Margin="16,0,8,0">
          <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource ColorText}" Opacity="0.8" FontSize="13" Text="Recent dictations" />
          <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
            <Button x:Name="ClearAllButton" Style="{StaticResource GhostButton}" Height="28" Padding="10,0" FontSize="12" Content="Clear all" Click="ClearAll"
                    AutomationProperties.Name="Clear all recent dictations" />
            <Button Width="28" Height="28" Margin="4,0,0,0" Padding="0" Content="×" FontSize="18" Background="Transparent" BorderBrush="Transparent"
                    Foreground="{DynamicResource ColorNeutral400}" Click="CloseWindow" AutomationProperties.Name="Close" />
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1" Margin="10,10,10,0">
        <TextBlock x:Name="EmptyText" Margin="8,18,8,22" Foreground="{DynamicResource ColorText}" Opacity="0.65" FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                   Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
        <ListBox x:Name="EntriesList" Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                 AutomationProperties.Name="Recent dictations" KeyboardNavigation.TabNavigation="Once">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Margin" Value="0,0,0,6" />
              <Setter Property="Padding" Value="0" />
              <Setter Property="Cursor" Value="Hand" />
              <Setter Property="AutomationProperties.Name" Value="{Binding Preview}" />
              <Setter Property="AutomationProperties.HelpText" Value="{Binding Details}" />
              <EventSetter Event="MouseLeftButtonUp" Handler="ChooseClickedEntry" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Card" Padding="12,9,6,9" Background="{DynamicResource ColorBg}" BorderBrush="{DynamicResource ColorDivider}" BorderThickness="1" CornerRadius="8">
                      <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource ColorAccent}" />
                      </Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="Card" Property="Background" Value="{DynamicResource ColorNeutral900}" />
                        <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource ColorAccent400}" />
                        <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                        <Setter TargetName="Card" Property="Padding" Value="11,8,5,8" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Foreground="{DynamicResource ColorText}" FontSize="14" Text="{Binding Preview}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                             MaxHeight="58" LineHeight="19" LineStackingStrategy="BlockLineHeight" />
                  <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                    <TextBlock Foreground="{DynamicResource ColorText}" Opacity="0.55" FontSize="12" Text="{Binding Details}" />
                    <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="5" Background="{DynamicResource ColorAccent800}"
                            Visibility="{Binding ShowNotInserted, Converter={StaticResource BoolToVisibility}}">
                      <TextBlock Foreground="{DynamicResource ColorAccent100}" FontSize="11" Text="Not inserted" />
                    </Border>
                  </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Width="26" Height="26" Margin="6,0,0,0" Padding="0" VerticalAlignment="Top" Content="×" FontSize="15"
                        Background="Transparent" BorderBrush="Transparent" Foreground="{DynamicResource ColorNeutral400}" Focusable="False"
                        Tag="{Binding}" Click="RemoveEntry" ToolTip="Remove" AutomationProperties.Name="Remove this dictation" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>

      <TextBlock x:Name="KeyHintText" Grid.Row="2" Margin="18,6,18,12" Foreground="{DynamicResource ColorText}" Opacity="0.5" FontSize="12" TextWrapping="Wrap"
                 Text="Enter or click pastes · Delete removes · Esc closes. Kept in memory only." />
    </Grid>
  </Border>
</Window>
