<Window x:Class="PrivateType.App.OpenSourceLicensesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="620" Height="520" WindowStartupLocation="CenterOwner" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" Foreground="{DynamicResource ColorText}"
        FontFamily="{DynamicResource AppFont}">
  <Border Margin="8" Background="{DynamicResource ColorSurface}" BorderBrush="{DynamicResource ColorDivider}" BorderThickness="1" CornerRadius="16">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Background="{DynamicResource ColorNeutral900}" CornerRadius="15,15,0,0">
        <Grid Margin="16,0,8,0">
          <TextBlock VerticalAlignment="Center" FontSize="13" Opacity=".8" Text="PrivateType — open-source licenses"/>
          <Button Width="28" Height="28" Padding="0" HorizontalAlignment="Right" Content="×" Background="Transparent" BorderBrush="Transparent" Click="Close"/>
        </Grid>
      </Border>
      <Grid Grid.Row="1" Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
          <TextBlock FontSize="22" FontWeight="SemiBold" Text="Open-source licenses"/>
          <TextBlock Margin="0,5,0,0" Opacity=".7" TextWrapping="Wrap" Text="PrivateType is MIT-licensed. Full notices for every bundled component are included with the portable app."/>
        </StackPanel>
        <TextBox x:Name="Notices" Grid.Row="2" IsReadOnly="True" Foreground="{DynamicResource ColorText}" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="{DynamicResource ColorBg}" BorderBrush="{DynamicResource ColorDivider}" Padding="12"/>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Margin="0,0,8,0" Content="Open licenses folder" Click="OpenLicensesFolder"/>
          <Button Content="Close" Click="Close"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
