<Window x:Class="PrivateType.App.OpenSourceLicensesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PrivateType open-source licenses" Icon="/PrivateType;component/Assets/PrivateType.ready.ico" Width="480" SizeToContent="Height" MaxHeight="640" WindowStartupLocation="CenterOwner" WindowStyle="None" UseLayoutRounding="True"
        AllowsTransparency="True" Background="Transparent" Foreground="{DynamicResource ColorText}"
        FontFamily="{DynamicResource AppFont}">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="FormStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <!-- The same slim dark scrollbar as Settings. -->
      <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
                <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Margin="3,4" Background="{DynamicResource ColorNeutral800}" CornerRadius="2" /></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
              </Track>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </Window.Resources>
  <Border Margin="8" Background="{DynamicResource ColorSurface}" BorderBrush="{DynamicResource ColorDivider}" BorderThickness="1" CornerRadius="12">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="40" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <!-- The same title bar as Settings: keycap mark, name, and what this window is for. -->
      <Border Background="{DynamicResource ColorSurface}" BorderBrush="{DynamicResource ColorHairline}" BorderThickness="0,0,0,1" CornerRadius="11,11,0,0" MouseLeftButtonDown="DragWindow">
        <Grid Margin="16,0,8,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="18" Height="18" CornerRadius="4" Background="{DynamicResource ColorKeycap}" BorderBrush="{DynamicResource ColorKeycapEdge}" BorderThickness="0,0,0,2">
              <Ellipse Width="6" Height="6" Fill="{DynamicResource ColorAccent400}" />
            </Border>
            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Text="PrivateType" />
            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource ColorNeutral400}" Text="open-source licenses" />
          </StackPanel>
          <Button Width="28" Height="28" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Center" Content="×" FontSize="18" Style="{StaticResource GhostButton}"
                  AutomationProperties.Name="Close" Click="Close" />
        </Grid>
      </Border>
      <!-- One page of credits. A read-only rich text box, so every line can be selected and copied; it scrolls when the
           page is taller than the window may grow. The page margin is the document's, so the scrollbar sits at the edge. -->
      <RichTextBox x:Name="CreditsPage" Grid.Row="1" IsReadOnly="True" Background="Transparent" BorderThickness="0" Padding="0"
                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" FocusVisualStyle="{x:Null}"
                   Foreground="{DynamicResource ColorText}" SelectionBrush="{DynamicResource ColorAccent}" SelectionOpacity="0.4"
                   AutomationProperties.Name="What PrivateType is built with">
        <FlowDocument x:Name="Page" PagePadding="28,22,28,20" FontFamily="{DynamicResource AppFont}" FontSize="13" />
      </RichTextBox>
      <!-- The same slim footer as Settings: the secondary action as text, the primary filled at the right. Each action is shown only when its target exists. -->
      <Border Grid.Row="2" Padding="24,10,16,12" BorderBrush="{DynamicResource ColorHairline}" BorderThickness="0,1,0,0">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Style="{StaticResource GhostButton}" Height="32" Padding="12,0" Content="Close" Click="Close" />
          <Button x:Name="FullNoticesButton" Margin="8,0,0,0" Height="32" Padding="14,0" Content="Full notices" Click="OpenFullNotices" />
          <Button x:Name="OpenLicenseTextsButton" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Height="32" Padding="16,0" Content="Open license texts" Click="OpenLicenseTexts" />
          <Button x:Name="GetCompleteZipButton" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Height="32" Padding="16,0" Content="Get the complete ZIP" Click="GetCompleteZip" />
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
