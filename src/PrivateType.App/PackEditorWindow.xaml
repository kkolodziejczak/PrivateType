<Window x:Class="PrivateType.App.PackEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit vocabulary pack" Icon="/PrivateType;component/Assets/PrivateType.ready.ico" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" ShowInTaskbar="False"
        Background="Transparent" Foreground="{DynamicResource ColorText}" FontFamily="{DynamicResource AppFont}">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="FormStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <!-- In a form, a dropdown keeps the same visible field as the text box beside it. -->
      <Style x:Key="FieldFrame" TargetType="Border">
        <Setter Property="Height" Value="30" />
        <Setter Property="Background" Value="{DynamicResource ColorBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ColorDivider}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Style.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource ColorNeutral800}" /></Trigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </Window.Resources>
  <Border Margin="8" Background="{DynamicResource ColorSurface}" BorderBrush="{DynamicResource ColorDivider}" BorderThickness="1" CornerRadius="12">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="40" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Border BorderBrush="{DynamicResource ColorHairline}" BorderThickness="0,0,0,1" CornerRadius="11,11,0,0" Background="Transparent" MouseLeftButtonDown="DragWindow">
        <Grid Margin="16,0,8,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="18" Height="18" CornerRadius="4" Background="{DynamicResource ColorKeycap}" BorderBrush="{DynamicResource ColorKeycapEdge}" BorderThickness="0,0,0,2">
              <Ellipse Width="6" Height="6" Fill="{DynamicResource ColorAccent400}" />
            </Border>
            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Text="Edit vocabulary pack" />
          </StackPanel>
          <Button Style="{StaticResource GhostButton}" Width="28" Height="28" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Center" Content="×" FontSize="18"
                  IsCancel="True" AutomationProperties.Name="Close" />
        </Grid>
      </Border>

      <StackPanel Grid.Row="1" Margin="24,6,24,16">
        <Border Style="{StaticResource TableRow}" BorderThickness="0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="96" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource RowLabel}" Text="Name" />
            <TextBox x:Name="NameBox" Grid.Column="1" Height="30" FontSize="13" MaxLength="80" AutomationProperties.Name="Pack name" />
          </Grid>
        </Border>
        <Border Style="{StaticResource TableRow}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="96" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource RowLabel}" Text="Language" />
            <Border Grid.Column="1" Style="{StaticResource FieldFrame}">
              <ComboBox x:Name="ScopeBox" Margin="-1" SelectedValuePath="Code"
                        IsTextSearchEnabled="True" TextSearch.TextPath="DisplayName" MaxDropDownHeight="320" AutomationProperties.Name="Pack language">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Foreground="{DynamicResource ColorText}" Text="{Binding DisplayName}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Border>
          </Grid>
        </Border>

        <TextBlock Style="{StaticResource GroupLabel}" Margin="0,18,0,8" Text="PHRASES" />
        <!-- Each phrase is a real text field, so it keeps its box; the remove key sits beside it. -->
        <ScrollViewer x:Name="PhraseScroll" MaxHeight="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
          <StackPanel>
            <ItemsControl x:Name="PhraseList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Height="30" FontSize="13" MaxLength="120"
                             Text="{Binding Phrase, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Pack phrase" />
                    <Button Grid.Column="1" Style="{StaticResource IconKeyButton}" Margin="8,0,0,0" VerticalAlignment="Center" ContentTemplate="{StaticResource RemoveGlyph}" Content="Remove"
                            Tag="{Binding}" Click="RemovePhrase" ToolTip="Remove phrase" AutomationProperties.Name="Remove phrase" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button x:Name="AddPhraseButton" Style="{StaticResource GhostKeyButton}" Margin="0,2,0,0" HorizontalAlignment="Left" Content="+ Add phrase" Click="AddPhrase" />
          </StackPanel>
        </ScrollViewer>
      </StackPanel>

      <!-- Slim footer: a message on the left, the text-button Cancel, then the filled primary action at the right. -->
      <Border Grid.Row="2" Padding="24,10,16,12" BorderBrush="{DynamicResource ColorHairline}" BorderThickness="0,1,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="ErrorText" Margin="0,0,16,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource ColorDanger}" TextWrapping="Wrap"
                     AutomationProperties.LiveSetting="Polite" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Style="{StaticResource GhostButton}" Margin="0,0,8,0" Height="32" Padding="12,0" Content="Cancel" IsCancel="True" />
            <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Height="32" Padding="16,0" Content="Save pack" IsDefault="True" Click="Save" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
