<Window x:Class="PrivateType.App.ImportSettingsPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bring over your settings" Icon="/PrivateType;component/Assets/PrivateType.ready.ico" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Foreground="{DynamicResource ColorText}" FontFamily="{DynamicResource AppFont}"
        Loaded="FocusImport">
  <Border Margin="8" Background="{DynamicResource ColorSurface}" BorderBrush="{DynamicResource ColorDivider}" BorderThickness="1" CornerRadius="16">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Background="{DynamicResource ColorNeutral900}" CornerRadius="15,15,0,0" MouseLeftButtonDown="DragWindow">
        <Grid Margin="16,0,8,0">
          <TextBlock VerticalAlignment="Center" Opacity=".8" FontSize="13" Text="PrivateType — earlier version found"/>
          <Button Width="28" Height="28" Padding="0" HorizontalAlignment="Right" Content="×" FontSize="18" Background="Transparent" BorderBrush="Transparent" Foreground="{DynamicResource ColorNeutral400}" AutomationProperties.Name="Start fresh" Click="StartFresh"/>
        </Grid>
      </Border>
      <Border Grid.Row="1" Padding="22" Background="{DynamicResource ColorSurface}" CornerRadius="0,0,14,14">
        <StackPanel>
          <TextBlock FontSize="22" FontWeight="SemiBold" Text="Bring over your settings?"/>
          <TextBlock x:Name="SourceText" Margin="0,6,0,0" Opacity=".75" FontSize="14" TextWrapping="Wrap"/>
          <Border Margin="0,16,0,0" Padding="12" Background="{DynamicResource ColorBg}" BorderBrush="{DynamicResource ColorDivider}" BorderThickness="1" CornerRadius="8">
            <TextBlock FontSize="13" TextWrapping="Wrap" Text="Copies your shortcuts, microphone, vocabulary and packs, sounds, recent dictation options, and speech model choice. Windows startup is asked separately. The earlier copy is not changed."/>
          </Border>
          <StackPanel Margin="0,22,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="ImportButton" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Content="Import settings" Click="Import"/>
            <Button x:Name="StartFreshButton" Content="Start fresh" IsCancel="True" Click="StartFresh"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
