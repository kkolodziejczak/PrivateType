<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Language: labels, values, phrases, dictated words. Segoe UI Variable ships with Windows 11. -->
  <FontFamily x:Key="AppFont">Segoe UI Variable Text, Segoe UI</FontFamily>
  <!-- Machine notation only: key legends, file names, versions, model IDs and the plain-text licence notices. Cascadia Mono ships with Windows 11. -->
  <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

  <!-- Neutral graphite: no blue tint in the greys. The accent is kept for the active key, the current page, focus and Save. -->
  <SolidColorBrush x:Key="ColorBg" Color="#141518" />
  <SolidColorBrush x:Key="ColorSurface" Color="#1B1C20" />
  <SolidColorBrush x:Key="ColorNeutral900" Color="#26272D" />
  <SolidColorBrush x:Key="ColorNeutral800" Color="#3A3C44" />
  <SolidColorBrush x:Key="ColorNeutral600" Color="#8E919B" />
  <SolidColorBrush x:Key="ColorNeutral400" Color="#B4B6BE" />
  <SolidColorBrush x:Key="ColorText" Color="#E9E9EC" />
  <SolidColorBrush x:Key="ColorDivider" Color="#24FFFFFF" />
  <SolidColorBrush x:Key="ColorHairline" Color="#14FFFFFF" />
  <SolidColorBrush x:Key="ColorKeycap" Color="#2A2C33" />
  <SolidColorBrush x:Key="ColorKeycapEdge" Color="#0E0F12" />
  <SolidColorBrush x:Key="ColorAccent" Color="#5B9EE0" />
  <SolidColorBrush x:Key="ColorAccentText" Color="#0E1116" />
  <SolidColorBrush x:Key="ColorAccent100" Color="#EEF6FD" />
  <SolidColorBrush x:Key="ColorAccent300" Color="#B8DDF5" />
  <SolidColorBrush x:Key="ColorAccent400" Color="#8AC3EA" />
  <SolidColorBrush x:Key="ColorAccent700" Color="#3A6390" />
  <SolidColorBrush x:Key="ColorAccent800" Color="#2A4868" />
  <SolidColorBrush x:Key="ColorAccent900" Color="#1C3148" />
  <SolidColorBrush x:Key="ColorDanger" Color="#E0808C" />
  <SolidColorBrush x:Key="ColorDangerSurface" Color="#48232C" />
  <SolidColorBrush x:Key="ColorSuccess" Color="#6CC28A" />
  <SolidColorBrush x:Key="ColorWarning" Color="#E3A948" />

  <!-- Buttons are keys: a raised cap with a darker bottom edge that flattens when pressed. -->
  <Style TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource ColorText}" />
    <Setter Property="Background" Value="{DynamicResource ColorKeycap}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ColorKeycapEdge}" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="6">
            <ContentPresenter x:Name="Content" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ColorNeutral800}" /></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.78" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ColorKeycap}" /><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource ColorKeycap}" /><Setter TargetName="Content" Property="TextElement.Foreground" Value="{DynamicResource ColorNeutral600}" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{DynamicResource ColorAccent}"/><Setter Property="BorderBrush" Value="{DynamicResource ColorAccent700}"/><Setter Property="Foreground" Value="{DynamicResource ColorAccentText}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{DynamicResource ColorDangerSurface}"/><Setter Property="Foreground" Value="{DynamicResource ColorDanger}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>

  <!-- A microphone on a 32x32 grid: the capsule is filled, the cradle and stand are stroked. -->
  <PathGeometry x:Key="MicrophoneCapsuleGlyph">
    M16,5 C13.8,5 12,6.8 12,9 V16 C12,18.2 13.8,20 16,20 C18.2,20 20,18.2 20,16 V9 C20,6.8 18.2,5 16,5 Z
  </PathGeometry>
  <PathGeometry x:Key="MicrophoneStandGlyph">
    M8.5,15 C8.5,19.1 11.9,22.5 16,22.5 C20.1,22.5 23.5,19.1 23.5,15 M16,22.5 V27 M12,27 H20
  </PathGeometry>
</ResourceDictionary>
